{
  "name": "cs-vaulte",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:scale": "node scripts/check-scale.mjs",
    "test:pipeline": "python3 -m unittest discover -s pipeline/tests",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate": "npm run check && npm test && npm run build && npm run check:links && npm run check:scale",
    "check:quiz": "node --experimental-strip-types scripts/check-quiz.mjs",
    "contribution:kit": "node --experimental-strip-types scripts/export-contribution-kit.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.4.0",
    "rehype-raw": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
