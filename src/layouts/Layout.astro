---
import { contributionConfig } from '../data/contribution-config';
import { getContributionFormUrl } from '../lib/contributions';
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import StudyBackground from "../components/StudyBackground.astro";
import AppearanceSettings from "../components/AppearanceSettings.astro";
import fontRegularUrl from "../assets/fonts/thmanyah/thmanyahsans-Regular.woff2?url";
import fontBoldUrl from "../assets/fonts/thmanyah/thmanyahsans-Bold.woff2?url";
import { getLangFromUrl, useTranslations, getLocalizedPath, getLanguageSwitcherPath } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "An open-source educational platform for Computer Science university students providing summaries and interactive quizzes.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const contributionUrl = getContributionFormUrl(contributionConfig) || getLocalizedPath('/contribute/', lang);
const t = useTranslations(lang);
const dir = lang === "ar" ? "rtl" : "ltr";
const socialImage = new URL(`${import.meta.env.BASE_URL}images/social-preview.png`, Astro.site).href;
const isNotFound = /\/404(?:\.html|\/)?$/.test(Astro.url.pathname);
const pagePath = Astro.url.pathname.endsWith('.html')
  ? Astro.url.pathname
  : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = new URL(pagePath, Astro.site).href;
const alternateUrl = new URL(getLanguageSwitcherPath(pagePath, lang), Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir} data-study-motion="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={fontBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontRegularUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | CS Vault</title>
    <meta name="title" content={`${title} | CS Vault`} />
    <meta name="description" content={description} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonicalUrl} />
      <link rel="alternate" hreflang={lang} href={canonicalUrl} />
      <link rel="alternate" hreflang={lang === 'ar' ? 'en' : 'ar'} href={alternateUrl} />
    </>}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | CS Vault`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CS Vault" />
    {!isNotFound && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="CS Vault study resources homepage" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | CS Vault`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="CS Vault study resources homepage" />

    <ClientRouter fallback="swap" />

    <!-- Inline Script to prevent Theme Toggling Flash -->
    <script is:inline>
      const getThemePreference = () => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") return saved;
        } catch { /* Use the system preference when storage is blocked. */ }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const theme = getThemePreference();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      (() => {
        let enabled = true;
        try { enabled = localStorage.getItem('cs-vault-motion') !== 'off'; }
        catch { /* Keep the original background when storage is blocked. */ }
        document.documentElement.dataset.studyMotion = enabled
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'on' : 'off';
      })();
    </script>
  </head>
  <body
    class="bg-gray-50 text-gray-900 dark:bg-dark-bg dark:text-gray-100 font-sans min-h-screen flex flex-col antialiased relative overflow-x-clip"
    data-copy-translations={JSON.stringify({
      copy: t("dashboard.copyCode"),
      copied: t("dashboard.copied"),
    })}
  >
    <a href="#main-content" class="skip-link">{t("nav.skip")}</a>
    <!-- Navigation Header -->
    <header class="glass-nav sticky top-0 z-50">
      <div
        class="site-width mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between"
      >
        <!-- Brand Logo -->
        <a
          href={getLocalizedPath("/", lang)}
          class="flex items-center min-h-11"
          id="nav-brand"
          dir={lang === 'ar' ? 'rtl' : 'ltr'}
          aria-label={`${t('nav.brand')} — ${t('nav.home')}`}
        >
          <span class="nav-brand-path" dir="ltr">~/</span><bdi dir={lang === 'ar' ? 'rtl' : 'ltr'}>{lang === 'ar' ? 'قبو-الحاسب' : 'cs-vault'}</bdi>
        </a>

        <!-- Action Items (Links & Theme Toggle) -->
        <nav class="flex items-center gap-2 sm:gap-4" id="main-nav">
          <a
            href={getLocalizedPath("/", lang)}
            aria-current={title === t("nav.home") ? "page" : undefined}
            class="inline-flex min-h-11 items-center px-3 text-sm font-medium"
          >
            {t("nav.home")}
          </a>

          <a href={contributionUrl} class="inline-flex min-h-11 items-center px-2 text-sm font-medium">{lang === 'ar' ? 'ساهم' : 'Contribute'}</a>

          <!-- Language Selector -->
          <a
            href={getLanguageSwitcherPath(Astro.url.pathname, lang)}
            data-language-switch
            class="inline-flex min-h-11 items-center text-sm font-medium border border-gray-200 dark:border-zinc-700 px-3 rounded-md hover:bg-gray-100 dark:hover:bg-zinc-900 text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white transition-colors duration-150"
          >
            {lang === "ar" ? "English" : "العربية "}
          </a>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            aria-label={t("nav.theme")}
            class="w-11 h-11 flex items-center justify-center rounded-md border border-gray-200 dark:border-zinc-700 hover:bg-gray-100 dark:hover:bg-zinc-900 text-gray-600 dark:text-zinc-300 transition-colors duration-150 cursor-pointer"
          >
            <!-- Sun Icon (Visible in dark mode) -->
            <svg
              id="theme-toggle-light-icon"
              class="w-5 h-5 hidden"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.46 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.41 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
              ></path>
            </svg>
            <!-- Moon Icon (Visible in light mode) -->
            <svg
              id="theme-toggle-dark-icon"
              class="w-5 h-5 hidden"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <!-- Decorative Study Background (persisted across pages) -->
    <StudyBackground />

    <!-- Mobile Swipe-Back Visual Indicator -->
    <div id="swipe-back-indicator" class="swipe-back-indicator" aria-hidden="true">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </div>

    <!-- Main Content Area -->
    <main id="main-content" tabindex="-1" class="site-width flex-grow w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="site-footer border-t py-7 mt-12"
    >
      <div
        class="site-footer-inner site-width mx-auto px-4 sm:px-6 lg:px-8 text-sm text-gray-600 dark:text-gray-300"
      >
        <details id="contribute" class="scroll-mt-24">
          <summary id="contribute-title">{t("contribute.title")}</summary>
          <p class="mt-3 leading-relaxed"><a href={contributionUrl} class="underline underline-offset-4">{lang === 'ar' ? 'أرسل مصادر أو JSON جاهزاً أو تصحيحاً عبر نموذج Google.' : 'Send material, prepared JSON, or a correction through Google Forms.'}</a></p>
          <p class="mt-2 leading-relaxed">{t("contribute.website")}</p>
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          <a
            href="https://github.com/realozk/CS-Vault"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center font-medium text-brand-700 dark:text-brand-500 underline underline-offset-4 hover:no-underline"
          >
            {t("contribute.github")}
          </a>
          <a href="mailto:r3al0zk@gmail.com" class="inline-flex min-h-11 items-center font-medium text-brand-700 dark:text-brand-500 underline underline-offset-4 hover:no-underline">{t("contribute.email")}</a>
          </div>
        </details>
        <AppearanceSettings />
        <p class="footer-copy">© {new Date().getFullYear()} {t("footer.text")}</p>
      </div>
    </footer>

    <div id="pomodoro-widget" class="pomodoro-widget" data-translations={JSON.stringify({
      open: t("pomodoro.open"),
      title: t("pomodoro.title"),
      study: t("pomodoro.study"),
      break: t("pomodoro.break"),
      studyPhase: t("pomodoro.studyPhase"),
      breakPhase: t("pomodoro.breakPhase"),
      breakStarted: t("pomodoro.breakStarted"),
      studyReady: t("pomodoro.studyReady"),
      settings: t("pomodoro.settings"),
      start: t("pomodoro.start"),
      pause: t("pomodoro.pause"),
      reset: t("pomodoro.reset"),
      skip: t("pomodoro.skip"),
      storageUnavailable: t("pomodoro.storageUnavailable"),
    })}>
      <section id="pomodoro-panel" class="pomodoro-panel hidden" aria-labelledby="pomodoro-title" aria-hidden="true">
        <h2 id="pomodoro-title" class="sr-only">{t("pomodoro.title")}</h2>
        <div class="pomodoro-readout">
          <p id="pomodoro-phase">{t("pomodoro.studyPhase")}</p>
          <p id="pomodoro-time" role="timer" aria-live="off" dir="ltr">50:00</p>
        </div>
        <p id="pomodoro-notice" class="hidden mt-2 rounded bg-zinc-100 p-2 text-xs text-zinc-900 dark:bg-zinc-800/60 dark:text-zinc-100" role="alert"></p>
        <div class="pomodoro-controls">
          <button id="pomodoro-toggle" type="button" class="pomodoro-action pomodoro-primary">{t("pomodoro.start")}</button>
          <button id="pomodoro-reset" type="button" class="pomodoro-action pomodoro-reset" aria-label={t("pomodoro.reset")} title={t("pomodoro.reset")}>
            <svg aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 11a9 9 0 1 1 2.6 7.4M3 4v7h7" /></svg>
          </button>
        </div>
        <details class="pomodoro-settings mt-2">
          <summary class="cursor-pointer py-1 text-xs text-gray-600 dark:text-gray-300">{t("pomodoro.settings")}</summary>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <label class="text-xs font-medium">{t("pomodoro.study")}
              <input id="pomodoro-study-minutes" class="mt-1 w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-gray-100" type="number" min="1" max="180" step="1" value="50" inputmode="numeric" />
            </label>
            <label class="text-xs font-medium">{t("pomodoro.break")}
              <input id="pomodoro-break-minutes" class="mt-1 w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-gray-100" type="number" min="1" max="180" step="1" value="10" inputmode="numeric" />
            </label>
          </div>
          <button id="pomodoro-skip" type="button" class="pomodoro-skip">{t("pomodoro.skip")}</button>
        </details>
        <p id="pomodoro-storage-status" class="hidden mt-3 text-xs text-amber-800 dark:text-amber-300" role="status"></p>
      </section>
      <button id="pomodoro-open" type="button" class="pomodoro-open" aria-label={t("pomodoro.open")} aria-expanded="false" aria-controls="pomodoro-panel">
        <svg aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="13" r="8.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v5l3 2M9 2h6M12 2v2.5M18.5 6.5 20 5" />
        </svg>
      </button>
    </div>

    <!-- Client-Side Hydration Script for Theme Management -->
    <script>
      const getSavedTheme = () => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") return saved;
        } catch { /* Use the system preference when storage is blocked. */ }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const applySavedTheme = () => {
        if (getSavedTheme() === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      const initThemeToggle = () => {
        const themeToggleBtn = document.getElementById("theme-toggle");
        const darkIcon = document.getElementById("theme-toggle-dark-icon");
        const lightIcon = document.getElementById("theme-toggle-light-icon");

        const isDarkMode = () =>
          document.documentElement.classList.contains("dark");

        const updateToggleButtonState = () => {
          themeToggleBtn?.setAttribute("aria-pressed", String(isDarkMode()));
          if (isDarkMode()) {
            lightIcon?.classList.remove("hidden");
            darkIcon?.classList.add("hidden");
          } else {
            lightIcon?.classList.add("hidden");
            darkIcon?.classList.remove("hidden");
          }
        };

        updateToggleButtonState();

        if (!themeToggleBtn || themeToggleBtn.dataset.bound === "true") return;
        themeToggleBtn.dataset.bound = "true";

        themeToggleBtn.addEventListener("click", () => {
          if (isDarkMode()) {
            document.documentElement.classList.remove("dark");
          } else {
            document.documentElement.classList.add("dark");
          }
          updateToggleButtonState();
          try {
            localStorage.setItem("theme", isDarkMode() ? "dark" : "light");
          } catch { /* Theme still works for this visit. */ }
        });
      };

      const initSwipeBack = () => {
        if (document.documentElement.dataset.swipeBackBound === "true") return;
        document.documentElement.dataset.swipeBackBound = "true";

        const getBackLink = () =>
          document.querySelector<HTMLAnchorElement>(".quiz-page-nav a[href], .subject-breadcrumbs a[href]");

        const hasHorizontalScroll = (target: EventTarget | null): boolean => {
          let el = target instanceof Element ? target : null;
          while (el && el !== document.body && el !== document.documentElement) {
            if (el instanceof HTMLElement && el.scrollWidth > el.clientWidth + 2) {
              const style = window.getComputedStyle(el);
              if (style.overflowX === "auto" || style.overflowX === "scroll") {
                return true;
              }
            }
            el = el.parentElement;
          }
          return false;
        };

        let tracking = false;
        let lockedAxis: "x" | "y" | null = null;
        let swipeDir: 1 | -1 = 1;
        let startX = 0;
        let startY = 0;
        let startTime = 0;
        let lastDx = 0;

        const resetVisuals = (animate = true) => {
          const indicator = document.getElementById("swipe-back-indicator");
          const main = document.getElementById("main-content");
          if (indicator) {
            indicator.classList.remove("is-active", "is-ready", "from-right");
            indicator.style.transform = "";
            indicator.style.opacity = "";
          }
          if (main) {
            if (animate) {
              main.style.transition = "transform 0.22s cubic-bezier(0.22, 1, 0.36, 1)";
              main.style.transform = "";
              window.setTimeout(() => {
                if (main.style.transform === "") main.style.transition = "";
              }, 230);
            } else {
              main.style.transition = "";
              main.style.transform = "";
            }
          }
        };

        document.addEventListener("touchstart", (event) => {
          if (event.touches.length !== 1 || !getBackLink()) {
            tracking = false;
            return;
          }
          const target = event.target as Element | null;
          if (target?.closest("button, a, input, textarea, select, label, summary, #quiz-controls, #pomodoro-widget, [data-no-swipe]") || hasHorizontalScroll(target)) {
            tracking = false;
            return;
          }
          const touch = event.touches[0];
          startX = touch.clientX;
          startY = touch.clientY;
          startTime = performance.now();
          lastDx = 0;
          lockedAxis = null;
          tracking = true;
        }, { passive: true });

        document.addEventListener("touchmove", (event) => {
          if (!tracking || event.touches.length !== 1) return;
          const touch = event.touches[0];
          const dx = touch.clientX - startX;
          const dy = touch.clientY - startY;
          const absX = Math.abs(dx);
          const absY = Math.abs(dy);

          if (!lockedAxis) {
            if (absX < 14 && absY < 14) return;
            if (absY > absX * 0.7) {
              lockedAxis = "y";
              tracking = false;
              return;
            }
            const isRtl = document.documentElement.dir === "rtl";
            const canSwipeRight = dx > 0;
            const canSwipeLeft = dx < 0 && (isRtl || startX > window.innerWidth - 64);
            if (!canSwipeRight && !canSwipeLeft) {
              lockedAxis = "y";
              tracking = false;
              return;
            }
            lockedAxis = "x";
            swipeDir = dx >= 0 ? 1 : -1;
          }

          if (lockedAxis !== "x") return;
          lastDx = dx;
          const rawDist = Math.max(0, dx * swipeDir);
          const progress = Math.min(1, Math.max(0, (rawDist - 14) / 68));
          const indicator = document.getElementById("swipe-back-indicator");
          const main = document.getElementById("main-content");

          if (indicator) {
            indicator.classList.add("is-active");
            indicator.classList.toggle("from-right", swipeDir === -1);
            indicator.classList.toggle("is-ready", progress >= 1);
            const pull = Math.min(54, progress * 44);
            const scale = (0.78 + progress * 0.26).toFixed(3);
            indicator.style.opacity = Math.min(1, progress * 1.25).toFixed(3);
            indicator.style.transform = `translate3d(${swipeDir * pull}px, -50%, 0) scale(${scale})`;
          }
          if (main && !document.body.classList.contains("quiz-running")) {
            const damped = Math.min(26, Math.pow(Math.max(0, rawDist - 14), 0.7) * 1.25) * swipeDir;
            main.style.transition = "none";
            main.style.transform = damped ? `translate3d(${damped.toFixed(1)}px, 0, 0)` : "";
          }
        }, { passive: true });

        const finishSwipe = (cancelled: boolean) => {
          if (!tracking) return;
          const wasHorizontal = lockedAxis === "x";
          const rawDist = Math.max(0, lastDx * swipeDir);
          const elapsed = Math.max(1, performance.now() - startTime);
          const velocity = rawDist / elapsed;
          tracking = false;
          lockedAxis = null;

          if (!wasHorizontal) return;

          const shouldNavigate = !cancelled && (rawDist >= 82 || (rawDist >= 44 && velocity >= 0.45));
          const backLink = shouldNavigate ? getBackLink() : null;
          resetVisuals(!backLink);
          if (backLink) {
            backLink.click();
          }
        };

        document.addEventListener("touchend", () => finishSwipe(false), { passive: true });
        document.addEventListener("touchcancel", () => finishSwipe(true), { passive: true });
      };

      initThemeToggle();
      initSwipeBack();
      document.addEventListener("astro:before-swap", (event) => {
        const swapEvent = event as Event & { newDocument?: Document; viewTransition?: { skipTransition: () => void } };
        const root = swapEvent.newDocument?.documentElement;
        if (!root) return;
        // Native page snapshots temporarily freeze their captured controls.
        // Keep the independent pixel effect, but make mobile and exam navigation
        // immediately interactive once the new document is available.
        if (window.innerWidth < 768 || window.matchMedia('(pointer: coarse)').matches
          || document.getElementById('quiz-widget') || swapEvent.newDocument?.getElementById('quiz-widget')) {
          swapEvent.viewTransition?.skipTransition();
        }
        root.classList.toggle("dark", getSavedTheme() === "dark");
        root.setAttribute("data-swap-init", "true");
      });
      document.addEventListener("astro:after-swap", () => {
        applySavedTheme();
        initThemeToggle();
        initSwipeBack();
        requestAnimationFrame(() => {
          document.documentElement.removeAttribute("data-swap-init");
        });
      });
      document.addEventListener("astro:page-load", initThemeToggle);
    </script>
    <script>
      // Static pages cannot read a visitor's query or fragment at build time.
      const syncLanguageSwitch = () => {
        const languageSwitch = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
        const languagePath = languageSwitch?.getAttribute('href');
        if (!languageSwitch || !languagePath) return;
        const target = new URL(languagePath, window.location.href);
        target.search = window.location.search;
        target.hash = window.location.hash;
        languageSwitch.href = target.href;
      };
      const initLanguageSwitch = () => {
        syncLanguageSwitch();
        const languageSwitch = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
        if (!languageSwitch || languageSwitch.dataset.languageBound === 'true') return;
        languageSwitch.dataset.languageBound = 'true';
        ['click', 'auxclick', 'pointerdown', 'focus', 'contextmenu'].forEach(event => languageSwitch.addEventListener(event, syncLanguageSwitch));
      };
      initLanguageSwitch();
      ['hashchange', 'popstate', 'pageshow', 'locationchange'].forEach(event => window.addEventListener(event, syncLanguageSwitch));
      document.addEventListener('astro:after-swap', initLanguageSwitch);
      document.addEventListener('astro:page-load', initLanguageSwitch);
    </script>
    <script src="../scripts/pomodoro.ts"></script>
  </body>
</html>
