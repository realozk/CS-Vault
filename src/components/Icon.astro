---
/**
 * Icon.astro — Centralized SVG icon component.
 * Replaces copy-pasted inline SVGs across the codebase.
 * 
 * Usage: <Icon name="chevron-right" class="w-4 h-4" />
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;

/**
 * Icon path data registry.
 * Each icon maps to: { paths, fill?, viewBox? }
 * - `paths`: array of SVG <path> d-attributes
 * - `fill`: if true, uses fill="currentColor" instead of stroke
 * - `viewBox`: custom viewBox (default "0 0 24 24")
 */
const icons: Record<string, { paths: string[]; fill?: boolean; viewBox?: string; strokeWidth?: string }> = {
  'chevron-right': {
    paths: ['M9 5l7 7-7 7'],
    strokeWidth: '2.5',
  },
  'arrow-left': {
    paths: ['M10 19l-7-7m0 0l7-7m-7 7h18'],
    strokeWidth: '2',
  },
  'book': {
    paths: ['M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'],
    strokeWidth: '2',
  },
  'clock': {
    paths: ['M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'],
    strokeWidth: '2',
  },
  'user': {
    paths: ['M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'],
    strokeWidth: '2',
  },
  'calendar': {
    paths: ['M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'],
    strokeWidth: '2',
  },
  'search': {
    paths: ['M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'],
    strokeWidth: '2.5',
  },
  'check-circle': {
    paths: ['M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'],
    strokeWidth: '2',
  },
  'lightbulb': {
    paths: ['M9.663 17h4.673M12 3v1m6.364.364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'],
    strokeWidth: '2',
  },
  'academic-cap': {
    paths: [
      'M12 14l9-5-9-5-9 5 9 5z',
      'M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479L12 20l-6.825-2.943a12.083 12.083 0 01.665-6.479L12 14z',
    ],
    strokeWidth: '2.5',
  },
};

const icon = icons[name];
---

{icon && (
  icon.fill ? (
    <svg class={className} fill="currentColor" viewBox={icon.viewBox || '0 0 24 24'} xmlns="http://www.w3.org/2000/svg">
      {icon.paths.map((d) => <path d={d}></path>)}
    </svg>
  ) : (
    <svg class={className} fill="none" stroke="currentColor" stroke-width={icon.strokeWidth || '2'} viewBox={icon.viewBox || '0 0 24 24'} xmlns="http://www.w3.org/2000/svg">
      {icon.paths.map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d}></path>)}
    </svg>
  )
)}
