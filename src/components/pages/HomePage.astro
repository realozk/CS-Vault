---
import { contributionConfig } from '../../data/contribution-config';
import { getContributionFormUrl } from '../../lib/contributions';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SemesterSection from '../../components/SemesterSection.astro';
import StudyBackground from '../StudyBackground.astro';
import Icon from '../Icon.astro';
import '../../styles/home.css';
import { getModules, getSubjectName } from '../../lib/modules';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const contributionUrl = getContributionFormUrl(contributionConfig) || getLocalizedPath('/contribute/', lang);
const t = useTranslations(lang);
const copy = lang === 'ar' ? {
  description: 'ملخصات واختبارات لطلاب علوم الحاسب.',
  directory: 'اختر مادتك',
  directoryNote: 'كل ما تحتاجه للمراجعة، في مكان واحد.',
  yearLabel: 'السنة الدراسية',
  searchHint: 'ابحث باسم المادة أو المحاضرة أو الموضوع',
  searchShortcut: 'اضغط Command K أو Control K للبحث، و Escape لمسح البحث.',
  emptyTitle: 'المحتوى في الطريق',
  emptyNote: 'لم تُضف مواد لهذه السنة بعد. يمكنك استكشاف سنة أخرى.',
} : {
  description: 'Summaries and quizzes for CS students.',
  directory: 'Choose your subject',
  directoryNote: 'Everything for your next study session, in one place.',
  yearLabel: 'STUDY YEAR',
  searchHint: 'Search by subject, lecture, or topic',
  searchShortcut: 'Press Command K or Control K to search and Escape to clear.',
  emptyTitle: 'A little more to come',
  emptyNote: 'There’s no material for this year yet. Explore another year to get started.',
};

// Fetch all summaries and quizzes to discover available subject/year modules
const summaries = await getCollection('summaries');
const quizzes = await getCollection('quizzes');

const modules = await getModules(lang);

// Auto-detect default year tab (first year with content)
const availableYears = [...new Set(modules.map(m => m.yearLevel))].sort((a, b) => a - b);
const defaultYear = availableYears.length > 0 ? availableYears[0] : 1;



// Compile Client-Side Search Index
const searchIndex = [
  ...modules.map(m => ({
    type: 'subject', title: m.subjectName, description: t('semester.title').replace('{sem}', String(m.semester)),
    author: '', subjectCode: getSubjectName(m.subject, 'en'), year: m.year,
    url: getLocalizedPath(`/${m.subject}/${m.year}`, lang),
    yearLevel: m.yearLevel, semester: m.semester
  })),
  ...summaries.map(s => {
    const parts = s.id.split('/');
    return {
      type: 'summary',
      title: s.data.title,
      description: s.data.description,
      author: s.data.author,
      subjectCode: getSubjectName(s.data.subject_code, lang),
      year: parts[1],
      url: `${getLocalizedPath(`/${parts[0]}/${parts[1]}`, lang)}#summary-content-${parts.slice(2).join('-').replace(/\.(md|json)$/, '')}`,
      yearLevel: s.data.year_level,
      semester: s.data.semester
    };
  }),
  ...quizzes.map(q => {
    const parts = q.id.split('/');
    const slug = parts.slice(2).join('-').replace(/\.(md|json)$/, '');
    return {
      type: 'quiz',
      title: q.data.title,
      description: `${t("quiz.practice")} — ${getSubjectName(q.data.subject, lang)}`,
      author: 'System',
      subjectCode: getSubjectName(q.data.subject, lang),
      year: parts[1],
      url: getLocalizedPath(`/${parts[0]}/${parts[1]}/quiz/${slug}`, lang),
      yearLevel: q.data.year_level,
      semester: q.data.semester
    };
  })
];

const searchIndexTranslations = JSON.stringify({
  resultsCount: t('search.resultsCount'),
  subjectBadge: t('search.subjectBadge'),
  summaryBadge: t('search.summaryBadge'),
  quizBadge: t('search.quizBadge'),
  openQuiz: lang === 'ar' ? 'ابدأ الاختبار ←' : 'Open quiz →',
  openSubject: lang === 'ar' ? 'استكشف المادة ←' : 'Open subject →',
  readSummary: lang === 'ar' ? 'اقرأ الملخص ←' : 'Read summary →',
  yearAndSem: t('search.yearAndSem')
});
---

<Layout title={t("nav.home")} description={copy.description}>
  <div class="home-layout">
    <div class="home-intro">
      <StudyBackground />
      <section class="home-hero" aria-labelledby="home-title">
        <h1 id="home-title">{t('nav.brand')}</h1>
        <p class="home-hero-description">{copy.description}</p>
        <div class="home-hero-meta">
          <p class="home-quote" data-random-home-quote={lang}>{t('hero.title')}</p>
          <a href={contributionUrl} class="home-contribute">{lang === 'ar' ? 'ساهم بمصادرك' : 'Contribute material'} ↗</a>
        </div>
      </section>

      <div class="home-search">
        <label for="global-search-input">{t('search.label')}</label>
        <div class="home-search-field">
          <Icon name="search" class="home-search-icon" />
          <input type="search" id="global-search-input" placeholder={t('search.placeholder')} autocomplete="off" aria-keyshortcuts="Meta+k Control+k" aria-describedby="home-search-shortcut" />
          <span class="home-search-hint" aria-hidden="true">{copy.searchHint}</span>
          <kbd class="home-search-key" aria-hidden="true" dir="ltr"><span data-search-modifier>Ctrl</span><span>K</span></kbd>
        </div>
        <span id="home-search-shortcut" class="sr-only">{copy.searchShortcut}</span>
      </div>
    </div>

    <section class="home-directory" aria-labelledby="directory-title">
      <div class="directory-heading">
        <div>
          <h2 id="directory-title">{copy.directory}</h2>
          <p>{copy.directoryNote}</p>
        </div>
        <span class="directory-subject-count">{modules.length.toString().padStart(2, '0')} <span>{t('dashboard.breadcrumbs')}</span></span>
      </div>
      <div id="directory-container" data-search-index={JSON.stringify(searchIndex)} data-translations={searchIndexTranslations}>
        <div id="search-results-pane" class="hidden">
          <div class="search-results-heading">
            <h3>{t('search.results')}</h3>
            <span id="search-results-count" role="status" aria-live="polite" aria-atomic="true">0 {t('search.resultsCount')}</span>
          </div>
          <div id="search-results-grid" class="course-grid"></div>
          <div id="search-no-results" class="directory-empty hidden">
            <Icon name="search" class="w-7 h-7" />
            <p>{t('search.noResults')}</p>
          </div>
        </div>

        <div id="core-tab-view" class="directory-layout">
          <div class="year-selector">
            <span class="year-selector-label">{copy.yearLabel}</span>
            <div class="year-sidebar" id="year-tabs-nav" role="group" aria-label={t('year.select')}>
              {[1, 2, 3, 4].map((year) => (
                <button type="button" data-year-tab={year} aria-pressed={year === defaultYear} aria-controls={`year-content-${year}`}>
                  <span>{t('year.tab').replace('{year}', year.toString())}</span>
                  <svg aria-hidden="true" class="year-arrow" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5" /></svg>
                </button>
              ))}
            </div>
          </div>
          {[1, 2, 3, 4].map((yearNum) => {
            const yearModules = modules.filter(m => m.yearLevel === yearNum);
            return (
              <div id={`year-content-${yearNum}`} data-year-content={yearNum} class={`year-material ${yearNum === defaultYear ? '' : 'hidden'}`}>
                {yearModules.length === 0 ? (
                  <div class="directory-empty">
                    <Icon name="book" class="w-8 h-8" />
                    <h3>{copy.emptyTitle}</h3>
                    <p>{copy.emptyNote}</p>
                  </div>
                ) : (
                  <div class="semester-list">
                    {[1, 2].filter(sem => yearModules.some(m => m.semester === sem)).map((sem) => (
                      <SemesterSection semester={sem} modules={yearModules.filter(m => m.semester === sem)} />
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script src="../../scripts/home.ts"></script>
