---
import { contributionConfig } from '../../data/contribution-config';
import { getContributionFormUrl } from '../../lib/contributions';
import { getSubjectName } from '../../lib/modules';
import type { CollectionEntry } from 'astro:content';
interface Props { quiz: CollectionEntry<'quizzes'>; }
import Layout from '../../layouts/Layout.astro';
import QuizWidget from '../../components/QuizWidget.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const contributionUrl = getContributionFormUrl(contributionConfig) || getLocalizedPath('/contribute/', lang);
const t = useTranslations(lang);


const { quiz } = Astro.props;
const { subject, year } = Astro.params;

const pageTitle = `${quiz.data.title} — ${t("quiz.practice")}`;

---

<Layout title={pageTitle} description={`${quiz.data.title} — ${getSubjectName(subject!, lang)} (${year})`}>
  <div class="quiz-page">
    <!-- Quiz Nav Header -->
    <div class="quiz-page-nav">
      <a 
        href={getLocalizedPath(`/${subject}/${year}`, lang)} 
      >
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t("quiz.backToSubject")}
      </a>
    </div>

    <p class="mb-4 text-sm"><a href={contributionUrl} class="inline-flex min-h-11 items-center underline underline-offset-4">{lang === 'ar' ? 'أرسل تصحيحاً لهذا الاختبار' : 'Suggest a correction'}</a></p>
    <!-- Main Widget Container -->
    <div>
      <QuizWidget quizId={quiz.id} quiz={quiz.data} backUrl={getLocalizedPath(`/${subject}/${year}`, lang)} />
    </div>
  </div>
</Layout>
