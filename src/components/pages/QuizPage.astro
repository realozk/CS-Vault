---
import { getSubjectName } from '../../lib/modules';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getQuestionStudyResources } from '../../lib/study-resources';
interface Props { quiz: CollectionEntry<'quizzes'>; }
import Layout from '../../layouts/Layout.astro';
import QuizWidget from '../../components/QuizWidget.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


const { quiz } = Astro.props;
const { subject, year } = Astro.params;
const studyResources = await getQuestionStudyResources({ quizId: quiz.id, questions: quiz.data.questions, section: quiz.data.section, summaries: await getCollection('summaries'), lang, baseUrl: import.meta.env.BASE_URL });

const pageTitle = `${quiz.data.title} — ${t("quiz.practice")}`;

---

<Layout title={pageTitle} description={`${quiz.data.title} — ${getSubjectName(subject!, lang, year)} (${year})`}>
  <div class="quiz-page">
    <!-- Quiz Nav Header -->
    <div class="quiz-page-nav">
      <a 
        href={getLocalizedPath(`/${subject}/${year}`, lang)} 
      >
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t("quiz.backToSubject")}
      </a>
      <span dir="auto" lang={quiz.data.lang || 'en'} class="quiz-page-title">{quiz.data.title}</span>
    </div>

    <!-- Main Widget Container -->
    <div>
      <QuizWidget quizId={quiz.id} quiz={quiz.data} studyResources={studyResources} backUrl={getLocalizedPath(`/${subject}/${year}`, lang)} />
    </div>
  </div>
</Layout>
