---
import { contributionConfig } from '../../data/contribution-config';
import { getContributionFormUrl } from '../../lib/contributions';
import { getCollection, render } from 'astro:content';
import QuizListItem from '../../components/QuizListItem.astro';
import MaterialContext from '../../components/MaterialContext.astro';
import { getCourseMeta } from '../../lib/modules';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
import { createSupplementaryQuizzes } from '../../lib/quiz-routes';
import { compareStudyEntries, getStudySection } from '../../lib/content-order';
import '../../styles/subject.css';

const lang = getLangFromUrl(Astro.url);
const contributionUrl = getContributionFormUrl(contributionConfig) || getLocalizedPath('/contribute/', lang);
const t = useTranslations(lang);


const { subject, year } = Astro.params;

// Fetch collections in parallel filtering by subject and year folder structure
const [rawSummaries, rawQuizzes] = await Promise.all([
  getCollection('summaries', (entry) => {
    const parts = entry.id.split('/');
    return parts[0] === subject && parts[1] === year;
  }),
  getCollection('quizzes', (entry) => {
    const parts = entry.id.split('/');
    return parts[0] === subject && parts[1] === year;
  }),
]);

// Helper to get slug from file path
const getSlug = (id: string) => {
  const parts = id.split('/');
  return parts.slice(2).join('-').replace(/\.(md|json)$/, '');
};

// Render summary content
const summaries = await Promise.all(
  [...rawSummaries].sort(compareStudyEntries).map(async (entry) => {
    const { Content } = await render(entry);
    const words = entry.body ? entry.body.split(/\s+/g).length : 0;
    const readingTime = Math.ceil(words / 200) || 1;
    return {
      entry,
      Content,
      slug: getSlug(entry.id),
      readingTime
    };
  })
);

const quizzes = [...rawQuizzes].sort(compareStudyEntries).map((entry) => ({
  entry,
  slug: getSlug(entry.id)
}));
for (const entry of createSupplementaryQuizzes(rawQuizzes)) {
  quizzes.push({ entry, slug: getSlug(entry.id) });
}
const quizGroupsByKey = new Map<string, { key: string; sectionNumber?: string; sectionType?: 'lecture' | 'chapter'; quizzes: typeof quizzes }>();
for (const quiz of quizzes) {
  const section = getStudySection(quiz.entry);
  const sectionType = section.kind === 'mixed' ? undefined : section.kind;
  const sectionNumber = section.number === undefined ? undefined : String(section.number);
  const isMixed = section.kind === 'mixed';
  const key = isMixed ? 'mixed' : `${sectionType}-${sectionNumber}`;
  const group = quizGroupsByKey.get(key);
  if (group) {
    group.quizzes.push(quiz);
  } else {
    quizGroupsByKey.set(key, {
      key,
      sectionNumber: isMixed ? undefined : sectionNumber,
      sectionType: isMixed ? undefined : sectionType,
      quizzes: [quiz],
    });
  }
}
const quizGroups = [...quizGroupsByKey.values()].sort((a, b) => Number(a.key === 'mixed') - Number(b.key === 'mixed'));

const module = getCourseMeta(subject!, year!, lang);
const subjectName = module.subjectName;
const pageTitle = `${subjectName} (${year})`;
const trackerTranslations = JSON.stringify({
  storageUnavailable: t('dashboard.storageUnavailable'),
  progressStatus: t('dashboard.progressStatus'),
});



const labels = lang === 'ar' ? {
  studyTools: 'أدوات المذاكرة',
  contents: 'المحتويات',
} : {
  studyTools: 'Study tools',
  contents: 'Contents',
};
const defaultMode = quizzes.length > 0 || summaries.length === 0 ? 'quizzes' : 'summaries';
---

<Layout title={pageTitle} description={`${subjectName} (${year}) — ${t("dashboard.quizzes")}, ${t("dashboard.summaries")}`}>
  <div id="subject-page" class="subject-page" data-default-study-mode={defaultMode} data-study-mode={defaultMode} data-study-enhanced="true">
    <header class="subject-heading">
      <nav class="subject-breadcrumbs" aria-label={t('dashboard.breadcrumbs')}>
        <a href={getLocalizedPath('/', lang)}>{t('dashboard.breadcrumbs')}</a>
        <span aria-hidden="true">/</span>
        <span>{subjectName}</span>
      </nav>
      <div class="subject-course-meta">
        <span class="subject-code" dir="ltr">{module.subjectCode}</span>
        <span>{lang === 'ar' ? 'سنة المجموعة' : 'Collection year'} {year}</span>
      </div>
      <h1 lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>{subjectName}</h1>
      <div class="subject-heading-summary">
        <a href={contributionUrl} class="subject-contribute">{lang === 'ar' ? 'ساهم بمصادرك' : 'Contribute material'}</a>
      </div>
    </header>

    <div id="subject-mode-switch" class="subject-mode-switch" data-subject-mode-switch role="group" aria-label={labels.studyTools}>
      <button type="button" data-study-mode="quizzes" aria-pressed={defaultMode === 'quizzes'} aria-controls="subject-quizzes">
        <Icon name="lightbulb" class="subject-mode-icon" />
        <span>{t('dashboard.quizzes')}</span>
        <span class="subject-mode-count">{quizzes.length}</span>
      </button>
      <button type="button" data-study-mode="summaries" aria-pressed={defaultMode === 'summaries'} aria-controls="subject-summaries">
        <Icon name="book" class="subject-mode-icon" />
        <span>{t('dashboard.summaries')}</span>
        <span class="subject-mode-count">{summaries.length}</span>
      </button>
    </div>
    <noscript>
      <style>
        #subject-mode-switch, .subject-finish-button { display: none !important; }
        #subject-quizzes.hidden, .summary-content-block.hidden { display: block !important; }
        #subject-summaries.hidden { display: grid !important; margin-top: 2.5rem !important; }
      </style>
      <nav class="subject-fallback-nav" aria-label={labels.studyTools}>
        <a href="#subject-quizzes">{t('dashboard.quizzes')} <span>{quizzes.length}</span></a>
        <a href="#subject-reading">{t('dashboard.summaries')} <span>{summaries.length}</span></a>
      </nav>
    </noscript>

    <section id="subject-quizzes" class:list={['subject-quiz-panel', { hidden: defaultMode !== 'quizzes' }]} data-study-panel="quizzes" data-score-storage-unavailable={t('dashboard.storageUnavailable')} aria-labelledby="subject-quizzes-heading">
      <div class="subject-section-heading">
        <div>
          <h2 id="subject-quizzes-heading">{t('dashboard.quizzes')}</h2>
        </div>
      </div>
      {quizzes.length === 0 ? (
        <div class="subject-empty"><p>{t('dashboard.emptyQuizzes')}</p></div>
      ) : (
        <div class="subject-quiz-groups">
          {quizGroups.map((group) => (
            <section class="subject-quiz-group">
              <h3>
                {group.sectionNumber && group.sectionType
                  ? t(group.sectionType === 'lecture' ? 'quiz.lectureGroup' : 'quiz.chapterGroup').replace('{number}', group.sectionNumber)
                  : t('quiz.mixedGroup')}
              </h3>
              <ul class="subject-quiz-list" role="list">
                {group.quizzes.map((q) => (
                  <li>
                    <QuizListItem quiz={q.entry} href={getLocalizedPath(`/${subject}/${year}/quiz/${q.slug}`, lang)} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
      <p id="quiz-score-storage-status" class="subject-storage-notice hidden" role="status"></p>
    </section>

    <section id="subject-summaries" class:list={['subject-summary-panel', { hidden: defaultMode !== 'summaries' }]} data-study-panel="summaries" aria-label={t('dashboard.summaries')}>
      <aside class="subject-contents">
        <div class="subject-contents-heading">
          <h2>{labels.contents}</h2>
        </div>
        {summaries.length > 0 ? (
          <>
            <nav class="subject-summary-list" id="summary-tabs" aria-label={labels.contents}>
              {summaries.map((s, idx) => (
                <a href={`#summary-content-${s.slug}`} data-summary-slug={s.slug} aria-controls={`summary-content-${s.slug}`} aria-current={idx === 0 ? 'true' : undefined} class="summary-tab-btn">
                  <span class="subject-summary-number" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                  <span dir={s.entry.data.lang === 'ar' ? 'rtl' : 'ltr'} lang={s.entry.data.lang} class="summary-title-text">{s.entry.data.title}</span>
                  <svg class="subject-summary-reviewed" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" /></svg>
                </a>
              ))}
            </nav>
            <div class="subject-progress" id="subject-progress-card" data-subject={subject} data-year={year} data-translations={trackerTranslations}>
              <div class="subject-progress-heading">
                <h2>{t('dashboard.progress')}</h2>
                <span id="progress-percentage-text">0%</span>
              </div>
              <div class="subject-progress-track" aria-hidden="true"><div id="subject-progress-fill"></div></div>
              <p id="progress-status-desc">{t('dashboard.progressStatus').replace('{checked}', '0').replace('{total}', String(summaries.length))}</p>
              <p id="progress-storage-status" class="subject-storage-notice hidden" role="status"></p>
            </div>
          </>
        ) : <p class="subject-contents-empty">{t('dashboard.emptySummaries')}</p>}
      </aside>

      <div id="subject-reading" class="subject-reading">
        {summaries.length === 0 ? (
          <div class="subject-empty subject-empty-reading">
            <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            <h2>{t('dashboard.noReading')}</h2>
            <p>{t('dashboard.emptySummaries')}</p>
          </div>
        ) : summaries.map((s, idx) => (
          <div id={`summary-content-${s.slug}`} class:list={['summary-content-block', { hidden: idx !== 0 }]}>
            <header class="subject-reading-heading">
              <h2 tabindex="-1" dir={s.entry.data.lang === 'ar' ? 'rtl' : 'ltr'} lang={s.entry.data.lang}>{s.entry.data.title}</h2>
              <MaterialContext
                description={s.entry.data.description}
                source={s.entry.data.source}
                sourceAcademicYear={s.entry.data.sourceAcademicYear}
                sourceTerm={s.entry.data.sourceTerm}
                updatedAt={s.entry.data.updatedAt}
                contentLang={s.entry.data.lang}
              />
              <div class="subject-reading-meta">
                <span><Icon name="user" class="subject-meta-icon" />{t('dashboard.authorLabel')} <bdi lang="en">{s.entry.data.author}</bdi></span>
                <span><Icon name="calendar" class="subject-meta-icon" />{t('dashboard.published')} <strong>{s.entry.data.date.toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</strong></span>
                <span><Icon name="clock" class="subject-meta-icon" />{t('dashboard.readingTime')} <strong>{t('dashboard.readTime').replace('{time}', s.readingTime.toString())}</strong></span>
              </div>
            </header>
            <article class="academic-prose" dir={s.entry.data.lang === 'ar' ? 'rtl' : 'ltr'} lang={s.entry.data.lang}>
              <s.Content />
            </article>
            <p class="subject-summary-notice" lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
              {lang === 'ar' ? 'الملخص لايغني عن مذاكره السلايدات.' : 'The summary does not replace studying the slides.'}
            </p>
            <label class="subject-review-check">
              <input type="checkbox" data-summary-check={s.slug} class="summary-checkbox" />
              <span>{t('dashboard.markReviewed')}</span>
            </label>
            {summaries.length > 1 && (
              <nav class="subject-reading-actions" aria-label={labels.contents}>
                <div>{idx > 0 && <a href={`#summary-content-${summaries[idx - 1].slug}`} data-nav-prev={summaries[idx - 1].slug} class="subject-action-secondary">{t('nav.previous')}</a>}</div>
                {idx < summaries.length - 1 ? (
                  <a href={`#summary-content-${summaries[idx + 1].slug}`} data-nav-next={summaries[idx + 1].slug} data-current-slug={s.slug} class="subject-action-primary">{t('nav.next')} <span aria-hidden="true" class="subject-next-arrow">→</span></a>
                ) : (
                  <button type="button" data-nav-finish={s.slug} class="subject-action-primary subject-finish-button">{t('nav.finish')} <span aria-hidden="true">✓</span></button>
                )}
              </nav>
            )}
          </div>
        ))}
      </div>
    </section>
  </div>
  <script src="../../scripts/subject-dashboard.ts"></script>
</Layout>
