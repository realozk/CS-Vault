---
import Layout from '../../layouts/Layout.astro';
import ContributionOptions from '../ContributionOptions.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { contributionConfig } from '../../data/contribution-config';
import { getContributionFormUrl } from '../../lib/contributions';
const t = useTranslations(getLangFromUrl(Astro.url));
const formUrl = getContributionFormUrl(contributionConfig);
---
<Layout title={t('contribute.pageTitle')} description={t('contribute.intro')}>
  <ContributionOptions formUrl={formUrl} />
</Layout>
