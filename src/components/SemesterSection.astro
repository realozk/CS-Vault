---
import type { ModuleItem } from '../types';
import CourseCard from './CourseCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

/**
 * SemesterSection.astro — Renders a semester header + module cards grid.
 * Extracted from duplicated Semester 1 / Semester 2 blocks in index.astro.
 */
interface Props {
  semester: number;
  modules: ModuleItem[];
}

const { semester, modules } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<div class="space-y-4">
  <h3 class="text-lg font-semibold text-gray-800 dark:text-zinc-200 flex flex-wrap items-center gap-3">
    <span>{t('semester.title').replace('{sem}', semester.toString())}</span>
    {semester === 1 && (
      <span
        class="text-xs font-normal text-gray-600 dark:text-zinc-400"
        data-academic-week
        data-week-start="2026-08-22"
        data-week-template={t('semester.week')}
      ></span>
    )}
  </h3>
  
  {modules.length === 0 ? (
    <div class="flex flex-col items-center justify-center py-8 px-4 border border-dashed border-gray-200 dark:border-zinc-800/80 rounded-md bg-gray-50/50 dark:bg-zinc-900/10 text-center">
      <svg class="w-8 h-8 text-gray-300 dark:text-zinc-700 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
      </svg>
      <p class="text-xs text-gray-400 dark:text-zinc-500 italic font-medium">{t('semester.empty')}</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {modules.map((m) => (
        <CourseCard module={m} />
      ))}
    </div>
  )}
</div>

<script>
  import { getAcademicWeekNumber } from '../lib/academic-week';

  declare global {
    interface Window {
      currentAcademicWeek: number;
    }
  }

  const weekElement = document.querySelector<HTMLElement>('[data-academic-week]');
  if (!weekElement) throw new Error('Academic week label is missing.');

  const weekStart = weekElement.dataset.weekStart;
  const template = weekElement.dataset.weekTemplate;
  if (!weekStart || !template) {
    throw new Error('Academic week label is missing its start date or translation.');
  }

  window.currentAcademicWeek = getAcademicWeekNumber(new Date(), weekStart);
  weekElement.textContent = template.replace('{n}', String(window.currentAcademicWeek));

  document.querySelectorAll<HTMLElement>('[data-academic-week-alert]').forEach((element) => {
    const targetWeek = Number(element.dataset.targetWeek);
    if (!Number.isInteger(targetWeek) || targetWeek < 1) {
      throw new Error('Academic week alert is missing a valid target week.');
    }

    element.hidden = window.currentAcademicWeek > targetWeek;
  });
</script>
