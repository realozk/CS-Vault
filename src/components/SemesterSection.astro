---
import type { ModuleItem } from '../types';
import CourseCard from './CourseCard.astro';

/**
 * SemesterSection.astro — Renders a semester header + module cards grid.
 * Extracted from duplicated Semester 1 / Semester 2 blocks in index.astro.
 */
interface Props {
  semester: number;
  modules: ModuleItem[];
  accentColor?: string;
}

const { semester, modules, accentColor = 'blue' } = Astro.props;

const colorMap: Record<string, string> = {
  blue: 'bg-blue-500',
  indigo: 'bg-indigo-500',
};
const dotColor = colorMap[accentColor] || 'bg-blue-500';
---

<div class="space-y-4">
  <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-zinc-500 flex items-center gap-2">
    <span>Semester {semester}</span>
    <span class={`w-1.5 h-1.5 rounded-full ${dotColor} animate-pulse`}></span>
  </h3>
  
  {modules.length === 0 ? (
    <p class="text-xs text-gray-400 dark:text-zinc-500 italic py-2">No subjects uploaded for this semester yet.</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {modules.map((m) => (
        <CourseCard module={m} />
      ))}
    </div>
  )}
</div>
