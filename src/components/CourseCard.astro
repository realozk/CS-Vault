---
import type { ModuleItem } from '../types';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/ui';

/**
 * CourseCard.astro — Reusable subject module card.
 * Extracted from duplicated markup in index.astro (was copy-pasted for Semester 1 and Semester 2).
 */
interface Props {
  module: ModuleItem;
}

const { module: m } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = getLocalizedPath(`/${m.subject}/${m.year}`, lang);
---

<a 
  href={href}
  class="group block spotlight-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border hover:border-brand-500 dark:hover:border-brand-500 rounded-md p-4 shadow-sm hover:shadow-lg hover:shadow-brand-500/15 dark:hover:shadow-brand-500/10 hover:-translate-y-1 transition-all duration-300 ease-out"
>
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded bg-gray-100 dark:bg-zinc-800/40 text-gray-600 dark:text-zinc-400 border border-transparent dark:border-dark-border">
      {m.subjectName.toUpperCase()}
    </span>
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform duration-150 text-gray-400 group-hover:text-brand-500 dark:group-hover:text-brand-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
  <h4 class="text-sm font-extrabold text-gray-900 dark:text-gray-100 tracking-tight group-hover:text-brand-500 dark:group-hover:text-brand-500 transition-colors">
    {m.subject.toUpperCase().replace(/-/g, ' ')}
  </h4>
  <div class="mt-3 pt-2.5 border-t border-gray-100 dark:border-dark-border flex gap-3 text-[10px] font-semibold text-gray-500 dark:text-gray-400">
    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> {m.summariesCount} {t('dashboard.summaries').toLowerCase()}</span>
    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> {m.quizzesCount} {t('dashboard.quizzes').toLowerCase()}</span>
  </div>
</a>
