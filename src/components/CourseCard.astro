---
import type { ModuleItem } from '../types';
import { hasMultipleCollections } from '../lib/course-catalog';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/ui';

/**
 * CourseCard.astro — Reusable subject module card.
 * Extracted from duplicated markup in index.astro (was copy-pasted for Semester 1 and Semester 2).
 */
interface Props {
  module: ModuleItem;
}

const { module: m } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = getLocalizedPath(`/${m.subject}/${m.year}`, lang);
const upcoming = m.summariesCount + m.quizzesCount === 0;
const showCollectionYear = hasMultipleCollections(m.subject);
---

<a href={href} class:list={["course-card group", { "course-card-upcoming": upcoming }]}>
  <div class="course-card-top">
    <span class="course-code" dir="ltr">{m.subjectCode}</span>
    {m.latestContentAt !== null && <span class="course-new" data-new-content-at={m.latestContentAt} hidden>{t('course.new')}</span>}
    <span class="course-open" aria-hidden="true">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5" /></svg>
    </span>
  </div>
  <h4>{m.subjectName}</h4>
  <div class="course-card-bottom">
    {showCollectionYear && <span>{lang === 'ar' ? 'سنة المجموعة' : 'Collection year'} <bdi>{m.year}</bdi></span>}
    {upcoming ? <span class="course-coming">{t('course.comingSoon')}</span> : <>
    <span><svg aria-hidden="true" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0" /></svg><strong>{m.quizzesCount}</strong> {t('course.quizzes')}</span>
    <span><svg aria-hidden="true" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v14m0-14C8 3 4 4 3 5v14c3-2 6-1 9 1 3-2 6-3 9-1V5c-2-1-6-2-9 1Z" /></svg><strong>{m.summariesCount}</strong> {t('course.summaries')}</span>
    </>}
  </div>
</a>
