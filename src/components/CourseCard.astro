---
import type { ModuleItem } from '../types';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/ui';

/**
 * CourseCard.astro — Reusable subject module card.
 * Extracted from duplicated markup in index.astro (was copy-pasted for Semester 1 and Semester 2).
 */
interface Props {
  module: ModuleItem;
}

const { module: m } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = getLocalizedPath(`/${m.subject}/${m.year}`, lang);
const alertKey = m.subject === 'programming-languages'
  ? 'courseAlert.programmingLanguages'
  : m.subject === 'operating-systems'
    ? 'courseAlert.operatingSystems'
    : m.subject === 'web-development'
    ? 'courseAlert.webdevelopment'
    : undefined;
---

<a 
  href={href}
  class="course-card group flex flex-col bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border hover:border-brand-700 dark:hover:border-brand-500 rounded-lg p-5 transition-colors duration-150"
>
  <div class="flex items-center justify-between gap-2 mb-2">
    <div class="flex flex-wrap items-center gap-2 min-w-0">
    <span class="font-mono text-xs font-medium px-2 py-1 rounded bg-gray-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-300">
      {m.subjectCode}
    </span>
    {m.isNew && <span class="rounded bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-300">{t('course.new')}</span>}
    {alertKey && (
      <span
        class="rounded bg-amber-50 px-2 py-1 text-xs font-medium leading-relaxed text-amber-800 dark:bg-amber-950/30 dark:text-amber-300"
        data-academic-week-alert
        data-target-week={m.subject === 'web-development' ? 9 : 8}
        hidden
      >
        {t(alertKey)}
      </span>
    )}
    </div>
    <svg aria-hidden="true" class="w-4 h-4 shrink-0 rtl:rotate-180 text-gray-500 dark:text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
  <h4 class="text-base font-semibold leading-relaxed text-gray-900 dark:text-gray-100 group-hover:text-brand-700 dark:group-hover:text-brand-500 transition-colors">
    {m.subjectName}
  </h4>
  {m.summariesCount + m.quizzesCount === 0 && <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t('course.comingSoon')}</p>}
  <div class="mt-auto pt-4">
    <div class="pt-3 border-t border-gray-100 dark:border-dark-border flex flex-wrap gap-x-4 gap-y-1 text-xs leading-relaxed text-gray-600 dark:text-gray-400">
      <span>{m.quizzesCount} {t('dashboard.quizzes').toLowerCase()}</span>
      <span>{m.summariesCount} {t('dashboard.summaries').toLowerCase()}</span>
    </div>
  </div>
</a>
