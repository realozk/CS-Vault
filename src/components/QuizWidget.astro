---
import QuizSourceLabel from './QuizSourceLabel.astro';
import { getSubjectName } from '../lib/modules';
import type { QuizData } from '../types';
import { getLangFromUrl, useTranslations, ui } from '../i18n/ui';

interface Props {
  quiz: QuizData;
  quizId?: string;
  backUrl?: string;
}

const { quiz, quizId = `${quiz.subject}/${quiz.year}/${quiz.title}`, backUrl = "../.." } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const serializedTranslations = JSON.stringify(Object.fromEntries(
  (Object.keys(ui.en) as (keyof typeof ui.en)[])
    .filter(key => key.startsWith('quiz.')).map(key => [key.slice(5), t(key)])
));
---

<div 
  id="quiz-widget" 
  class="relative w-full max-w-2xl mx-auto bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md shadow-xs overflow-hidden transition-all duration-300"
  data-os-dinosaur={quiz.subject === 'Operating Systems' ? 'true' : undefined}
  data-quiz={JSON.stringify(quiz)}
  data-quiz-id={quizId}
  data-translations={serializedTranslations}
>
  <!-- 1. Start Screen -->
  <div id="quiz-start-screen" class="p-8 text-center sm:p-12">
    <div class="inline-flex p-2.5 rounded-sm bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 mb-6 border border-blue-200 dark:border-blue-900/50">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364.364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
      </svg>
    </div>
    
    <div>
      <span class="text-xs font-bold tracking-wider text-blue-600 dark:text-blue-400 uppercase bg-blue-100 dark:bg-blue-950/40 px-3 py-1 rounded-sm border border-blue-200 dark:border-blue-900/50">
        {getSubjectName(quiz.subject, lang)} • {quiz.year}
      </span>
    </div>
    
    <div class="mt-4"><QuizSourceLabel sourceKind={quiz.sourceKind} /></div>
    <h2 dir="auto" lang={quiz.lang || 'en'} class="mt-6 text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      {quiz.title}
    </h2>
    
    {quiz.source && <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">{t('quiz.source')}: <bdi dir="ltr">{quiz.source}</bdi></p>}
    {quiz.sourceKind === 'instructor' && <p class="mt-4 text-sm text-gray-600 dark:text-gray-300">{t('quiz.instructorNotice')}</p>}
    {quiz.sourceKind === 'provided' && <p class="mt-4 text-sm text-gray-600 dark:text-gray-300">{t('quiz.providedNotice')}</p>}
    {(!quiz.sourceKind || quiz.sourceKind === 'generated') && quiz.questions.some(q => q.answerSource === 'inferred') && <p class="mt-4 text-sm text-amber-800 dark:text-amber-300">{t(quiz.subject === 'Operating Systems' ? 'quiz.aiLectureNotice' : 'quiz.aiDisclaimer')}</p>}

    <fieldset class="mt-6 text-start border border-gray-200 dark:border-zinc-800 rounded-md p-4 space-y-3">
      <legend class="px-2 text-sm font-semibold">{t('quiz.settings')}</legend>
      <div class="flex flex-wrap gap-5">
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="quiz-mode" value="practice" checked />{t('quiz.practice')}</label>
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="quiz-mode" value="exam" />{t('quiz.exam')}</label>
      </div>
      <p id="quiz-mode-help" class="text-sm text-gray-500 dark:text-gray-400">{t('quiz.practiceHelp')}</p>
      <div id="quiz-timer-settings" class="hidden space-y-3">
        <label class="flex items-center gap-2"><input id="quiz-use-timer" type="checkbox" checked />{t('quiz.useTimer')}</label>
        <label class="flex flex-wrap items-center gap-3" for="quiz-minutes">
          {t('quiz.minutes')}
          <input id="quiz-minutes" type="number" min="1" max="180" step="1" value="20" required class="w-24 border border-gray-300 dark:border-zinc-700 rounded bg-white dark:bg-zinc-900 px-3 py-2" />
        </label>
      </div>
    </fieldset>

    <div class="mt-8 flex flex-col items-center justify-center gap-3">
      <button 
        id="start-quiz-btn"
        class="w-full sm:w-auto px-6 py-3 bg-zinc-900 hover:bg-zinc-800 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 font-semibold rounded transition-all duration-150 cursor-pointer"
      >
        {t('quiz.start')}
      </button>
      <span id="quiz-mode-subtext" class="text-xs text-gray-400">{t('quiz.subtext')}</span>
    </div>

  </div>

  <!-- 2. Active Quiz Screen -->
  <div id="quiz-active-screen" class="hidden p-6 sm:p-8">
    <!-- Header info -->
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">
        <span id="quiz-counter-wrapper" set:html={t('quiz.currentQuestion').replace('{current}', '<span id="quiz-current-question-num">1</span>').replace('{total}', `<span id="quiz-total-questions-num">${quiz.questions.length}</span>`)} />
      </span>
      <span id="quiz-timer" role="timer" aria-label={t('quiz.timeRemaining')} class="text-xs font-medium text-gray-400 bg-gray-100 dark:bg-zinc-800 px-2.5 py-1 rounded-sm border border-transparent dark:border-zinc-700">
        {t('quiz.active')}
      </span>
    </div>

    <!-- Progress Bar -->
    <div class="w-full h-1.5 bg-gray-100 dark:bg-zinc-800 rounded-xs mb-6 overflow-hidden">
      <div id="quiz-progress-bar" class="h-full bg-blue-600 dark:bg-blue-500 w-0 transition-all duration-150"></div>
    </div>

    <!-- Question container (Forced to LTR and English Font) -->
    <div dir={quiz.lang === 'ar' ? 'rtl' : 'ltr'} lang={quiz.lang || 'en'} class="font-sans text-start">
      <!-- Question Text -->
      <h3 id="quiz-question-text" tabindex="-1" class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-6">
        Question loading...
      </h3>

      <!-- Question Code Snippet -->
      <pre id="quiz-question-code" class="hidden p-4 mb-6 bg-zinc-950 text-zinc-100 rounded-md overflow-x-auto text-sm font-mono border border-gray-800 dark:border-zinc-800"></pre>

      <!-- Options List -->
      <div id="quiz-options-container" class="space-y-3.5">
        <!-- Options will be injected here via JavaScript -->
      </div>
    </div>

    <p id="quiz-answer-status" class="mt-4 text-sm text-gray-600 dark:text-gray-300" role="status" />

    <!-- Explanation Card -->
    <div 
      id="quiz-explanation-box" 
      class="hidden mt-6 p-4 border border-blue-100 dark:border-blue-950/40 bg-blue-50/20 dark:bg-blue-950/10 rounded transition-all duration-150"
    >
      <div class="flex gap-3">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364.364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <div>
          <h4 class="font-bold text-sm text-blue-950 dark:text-blue-200">{t('quiz.explanation')}</h4>
          <p id="quiz-explanation-text" dir={quiz.lang === 'ar' ? 'rtl' : 'ltr'} lang={quiz.lang || 'en'} class="mt-1 text-sm text-blue-900/90 dark:text-blue-300/80">
            Explanation content...
          </p>
          <p id="quiz-source-slide" class="mt-2 text-xs text-blue-800 dark:text-blue-300" />
          <p id="quiz-answer-warning" class="mt-2 text-xs text-amber-800 dark:text-amber-300" />
        </div>
      </div>
    </div>

    <!-- Next / Submit Panel -->
    <div class="mt-8 pt-6 border-t border-gray-100 dark:border-zinc-800 flex flex-wrap justify-between gap-3">
      <button id="quiz-previous-btn" class="hidden px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded disabled:opacity-50 cursor-pointer">{t('quiz.previous')}</button>
      <button id="quiz-submit-btn" class="hidden px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded cursor-pointer">{t('quiz.submit')}</button>
      <button 
        id="quiz-next-btn"
        disabled
        class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 disabled:bg-gray-150 dark:disabled:bg-zinc-800 text-white disabled:text-gray-400 dark:disabled:text-zinc-500 font-semibold rounded cursor-pointer disabled:cursor-not-allowed transition-all duration-150"
      >
        {t('quiz.next')}
      </button>
    </div>
  </div>

  <!-- 3. Result Screen -->
  <div id="quiz-result-screen" class="hidden p-8 text-center sm:p-12">
    <div class="inline-flex p-2.5 rounded-sm bg-emerald-100 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 mb-6 border border-emerald-200 dark:border-emerald-900/50">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>

    <h2 id="quiz-result-title" tabindex="-1" class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      {t('quiz.completed')}
    </h2>
    <p id="quiz-performance-desc" class="mt-3 text-base text-gray-500 dark:text-gray-400 max-w-md mx-auto">
      {t('quiz.breakdown')}
    </p>

    <p id="quiz-expired-message" class="hidden mt-3 text-sm text-amber-800 dark:text-amber-300" role="status">{t('quiz.expired')}</p>
    <p class="mt-2 text-xs text-gray-500">{t('quiz.sessionScore')}</p>

    <!-- Scorecard Panel -->
    <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto my-8 border border-gray-200 dark:border-zinc-800 rounded-md bg-gray-50/50 dark:bg-zinc-900/30 p-4">
      <div class="text-center p-3 border-r border-gray-200 dark:border-zinc-800">
        <span class="block text-xs uppercase tracking-wider font-semibold text-gray-400 dark:text-zinc-500">{t('quiz.correct')}</span>
        <span id="quiz-score-ratio" class="block text-3xl font-extrabold text-gray-900 dark:text-white mt-1">0/0</span>
      </div>
      <div class="text-center p-3">
        <span class="block text-xs uppercase tracking-wider font-semibold text-gray-400 dark:text-zinc-500">{t('quiz.percentage')}</span>
        <span id="quiz-score-percentage" class="block text-3xl font-extrabold text-blue-600 dark:text-blue-400 mt-1">0%</span>
      </div>
    </div>

    <section class="mb-6 text-start space-y-3" aria-labelledby="quiz-topic-title">
      <h3 id="quiz-topic-title" class="text-lg font-bold">{t('quiz.topics')}</h3>
      <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead><tr class="border-b border-gray-200 dark:border-zinc-800"><th scope="col" class="text-start py-2">{t('quiz.topicLabel')}</th><th scope="col" class="text-start py-2">{t('quiz.topicScore')}</th></tr></thead>
        <tbody id="quiz-topic-results" />
      </table></div>
    </section>
    <section class="mb-6 text-start space-y-3" aria-labelledby="quiz-review-title">
      <h3 id="quiz-review-title" class="text-lg font-bold">{t('quiz.mistakes')}</h3>
      <div id="quiz-mistake-list" class="space-y-4" />
      <button id="quiz-retry-missed-btn" class="hidden w-full px-4 py-3 border border-gray-300 dark:border-zinc-700 rounded font-semibold cursor-pointer hover:bg-gray-50 dark:hover:bg-zinc-800">{t('quiz.retryMissed')}</button>
    </section>

    <!-- Retry Controls -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button 
        id="quiz-restart-btn"
        class="w-full sm:w-auto px-6 py-3 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-100 font-semibold rounded transition-all duration-150 cursor-pointer"
      >
        {t('quiz.fullRetry')}
      </button>
      <button id="quiz-settings-btn" class="w-full sm:w-auto px-4 py-3 border border-gray-200 dark:border-zinc-800 rounded font-semibold cursor-pointer">{t('quiz.settings')}</button>
      <a
        id="quiz-back-btn"
        href={backUrl}
        class="w-full sm:w-auto px-6 py-3 border border-gray-200 dark:border-zinc-800 hover:bg-gray-50 dark:hover:bg-zinc-800 text-gray-700 dark:text-gray-300 font-semibold rounded transition-all duration-150"
      >
        {t('quiz.back')}
      </a>
    </div>
  </div>
  {quiz.subject === 'Operating Systems' && <div class="quiz-dinosaur" title={t('quiz.dinosaur')}><img src={`${import.meta.env.BASE_URL}images/os-dinosaur.jpg`} alt={t('quiz.dinosaur')} width="60" height="47" loading="lazy" /></div>}
  {quiz.subject === 'Operating Systems' && <div class="quiz-shawarma" title={t('quiz.shawarma')}><img src={`${import.meta.env.BASE_URL}images/os-shawarma.png`} alt={t('quiz.shawarma')} width="60" height="60" loading="lazy" /></div>}
  <p id="quiz-storage-status" class="px-6 pb-3 text-sm text-gray-500 dark:text-gray-400" role="status" />
</div>

<script src="../scripts/quiz.ts"></script>
