---
import QuizSourceLabel from './QuizSourceLabel.astro';
import MaterialContext from './MaterialContext.astro';
import QuestionIssue from './QuestionIssue.astro';
import { packStudyResources, type StudyResource } from '../lib/study-resources';
import '../styles/quiz.css';
import { getSubjectName } from '../lib/modules';
import { getPracticeQuestions, getQuizQuestionPath } from '../lib/quiz-questions';
import type { QuizData } from '../types';
import { getLangFromUrl, getLocalizedPath, useTranslations, ui } from '../i18n/ui';

interface Props {
  quiz: QuizData;
  quizId?: string;
  backUrl?: string;
  studyResources?: Record<number, StudyResource>;
}

const { quiz, quizId = `${quiz.subject}/${quiz.year}/${quiz.title}`, backUrl = "../..", studyResources = {} } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const combined = quiz.sourceKind === 'combined' || quizId.endsWith('/all-questions');
const practiceQuestions = getPracticeQuestions(quiz.questions);
const disputedQuestions = quiz.questions.filter(question => question.status === 'disputed');
const topics = [...new Set(practiceQuestions.map(question => question.topic || 'general'))];
const originUrls = Object.fromEntries(quiz.questions.flatMap(question => question.origin
  ? [[question.origin.quizId, getLocalizedPath(getQuizQuestionPath(question.origin.quizId), lang)]]
  : []));
const serializedTranslations = JSON.stringify(Object.fromEntries(
  (Object.keys(ui.en) as (keyof typeof ui.en)[])
    .filter(key => key.startsWith('quiz.')).map(key => [key.slice(5), t(key)])
));
---

<div
  id="quiz-widget"
  class="study-quiz relative w-full mx-auto overflow-hidden"
  data-os-dinosaur={quiz.subject === 'Operating Systems' ? 'true' : undefined}
  data-quiz={JSON.stringify(quiz)}
  data-quiz-id={quizId}
  data-translations={serializedTranslations}
  data-origin-urls={JSON.stringify(originUrls)}
  data-study-resources={JSON.stringify(packStudyResources(studyResources))}
  data-question-report-base={getLocalizedPath('/contribute/', lang)}
>
  <noscript>
    <p class="quiz-help p-6" role="status">{t('quiz.requiresJavaScript')}</p>
    <style>
      #quiz-widget .quiz-setup,
      #quiz-widget .quiz-start-actions,
      #quiz-widget .quiz-result-section { display: none !important; }
    </style>
  </noscript>
  <div id="quiz-start-screen" class="quiz-screen">
    <div class="quiz-intro">
      <p class="quiz-eyebrow">{getSubjectName(quiz.subject, lang, quiz.year)} <span aria-hidden="true">/</span> {lang === 'ar' ? 'سنة المجموعة' : 'Collection year'} {quiz.year}</p>
      <h1 dir="auto" lang={quiz.lang || 'en'} class="quiz-title">{quiz.title}</h1>
      <MaterialContext
        description={quiz.description}
        sourceAcademicYear={quiz.sourceAcademicYear}
        sourceTerm={quiz.sourceTerm}
        updatedAt={quiz.updatedAt}
        contentLang={quiz.lang}
      />
      <div class="quiz-intro-meta">
        <span class="quiz-question-count"><strong>{practiceQuestions.length}</strong> {t('quiz.questions')}</span>
        <span aria-hidden="true" class="quiz-meta-divider"></span>
        <QuizSourceLabel sourceKind={quiz.sourceKind} combined={combined} />
      </div>
      {disputedQuestions.length > 0 && <p class="quiz-help mt-3">{t('quiz.disputedNotice').replace('{count}', String(disputedQuestions.length))}</p>}
    </div>

    <fieldset class="quiz-setup">
      <legend>{t('quiz.settings')}</legend>
      <div class="quiz-mode-options">
        <label class="quiz-mode-option">
          <input type="radio" name="quiz-mode" value="practice" checked />
          <span>{t('quiz.practice')}</span>
          <svg aria-hidden="true" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
        </label>
        <label class="quiz-mode-option">
          <input type="radio" name="quiz-mode" value="exam" />
          <span>{t('quiz.exam')}</span>
          <svg aria-hidden="true" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
        </label>
      </div>
      <p id="quiz-mode-help" class="quiz-help">{t('quiz.practiceHelp')}</p>
      <div class="quiz-session-options">
        <label for="quiz-length">{t('quiz.sessionLength')}</label>
        <select id="quiz-length">
          <option value="full">{t('quiz.fullQuiz')}</option>
          <option value="quick">{t('quiz.quickTen')}</option>
        </select>
      </div>
      <details class="quiz-more-options" hidden={topics.length < 2}>
        <summary>{t('quiz.moreOptions')}</summary>
        <label for="quiz-topic">{t('quiz.practiceTopic')}</label>
        <select id="quiz-topic">
          <option value="">{t('quiz.allTopics')}</option>
          {topics.map(topic => <option value={topic}>{t(`quiz.topic.${topic}` as keyof typeof ui.en) || (topic === 'general' ? t('quiz.noTopics') : topic.replaceAll('-', ' '))}</option>)}
        </select>
      </details>
      <p id="quiz-session-size" class="quiz-help" role="status"></p>
      <div id="quiz-timer-settings" class="hidden quiz-timer-settings">
        <label class="quiz-timer-toggle"><input id="quiz-use-timer" type="checkbox" checked />{t('quiz.useTimer')}</label>
        <label class="quiz-minutes-label" for="quiz-minutes">
          {t('quiz.minutes')}
          <input id="quiz-minutes" type="number" min="1" max="180" step="1" value="20" required inputmode="numeric" />
        </label>
      </div>
    </fieldset>

    <div class="quiz-start-actions">
      <button id="start-quiz-btn" class="quiz-primary" disabled={!practiceQuestions.length}>
        {t('quiz.start')}
        <svg aria-hidden="true" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="rtl:rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
    </div>

    <section id="quiz-saved-section" class="quiz-result-section hidden" aria-labelledby="quiz-saved-title">
      <h2 id="quiz-saved-title" class="text-base font-semibold">{t('quiz.savedReview')}</h2>
      <p id="quiz-saved-count" class="quiz-help" role="status">{t('quiz.noSaved')}</p>
      <p class="quiz-help">{t('quiz.reviewHelp')}</p>
      <div class="quiz-result-actions">
        <button id="quiz-review-saved-btn" class="quiz-secondary" disabled>{t('quiz.savedReview')}</button>
        <button id="quiz-clear-saved-btn" class="quiz-secondary" disabled>{t('quiz.clearSaved')}</button>
      </div>
    </section>

    {disputedQuestions.length > 0 && <details class="quiz-source-details">
      <summary>{t('quiz.disputedQuestions')}</summary>
      <div class="quiz-source-content">
        {disputedQuestions.map(question => <article class="space-y-2" dir={question.origin?.lang === 'ar' || (!question.origin?.lang && quiz.lang === 'ar') ? 'rtl' : 'ltr'} lang={question.origin?.lang || quiz.lang || 'en'}>
          <h2 class="font-semibold">{question.origin?.questionId ?? question.id}. {question.question}</h2>
          {question.code && <pre dir="ltr" class="overflow-x-auto">{question.code}</pre>}
          <p>{t('quiz.sourceAnswer')}: {question.correctAnswer}</p>
          {question.explanation && <p>{question.explanation}</p>}
          <p>{question.reviewNote}</p>
          {question.origin && <p><a class="underline underline-offset-4" href={originUrls[question.origin.quizId]}>{t('quiz.originalQuestion').replace('{id}', String(question.origin.questionId))} — {question.origin.title}</a></p>}
        </article>)}
      </div>
    </details>}

    <details class="quiz-source-details">
      <summary>{t('quiz.source')}<svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg></summary>
      <div class="quiz-source-content">
        {quiz.source && <p>{t('quiz.source')}: <bdi dir="ltr">{quiz.source}</bdi></p>}
        {quiz.sourceKind === 'instructor' && <p>{t('quiz.instructorNotice')}</p>}
        {quiz.sourceKind === 'provided' && <p>{t('quiz.providedNotice')}</p>}
        {combined && <p>{t('quiz.combinedNotice')}</p>}
        {!combined && (!quiz.sourceKind || quiz.sourceKind === 'generated') && quiz.questions.some(q => q.answerSource === 'inferred') && <p class="quiz-source-warning">{t(quiz.subject === 'Operating Systems' ? 'quiz.aiLectureNotice' : 'quiz.aiDisclaimer')}</p>}
        <p>{t('quiz.languageNote')}</p>
      </div>
    </details>
  </div>

  <div id="quiz-resume-screen" class="hidden quiz-screen">
    <div class="quiz-intro">
      <p class="quiz-eyebrow">{getSubjectName(quiz.subject, lang, quiz.year)} <span aria-hidden="true">/</span> {quiz.year}</p>
      <h2 id="quiz-resume-title" tabindex="-1" class="quiz-title">{t('quiz.resumeTitle')}</h2>
      <p id="quiz-resume-desc" class="quiz-resume-desc">{t('quiz.resumePrompt')}</p>
    </div>

    <div class="quiz-resume-card">
      <div class="quiz-resume-progress-header">
        <span id="quiz-resume-progress-text" class="quiz-resume-progress-text"></span>
      </div>
      <div class="quiz-progress-track quiz-resume-track">
        <div id="quiz-resume-progress-bar" class="h-full w-0"></div>
      </div>

      <div id="quiz-resume-stats" class="quiz-resume-stats" role="group" aria-label={t('quiz.progressSummary')}>
        <div class="quiz-resume-stat">
          <span class="quiz-resume-stat-label">{t('quiz.solvedCount')}</span>
          <strong id="quiz-resume-solved" class="quiz-resume-stat-value">0</strong>
        </div>
        <div class="quiz-resume-stat">
          <span class="quiz-resume-stat-label">{t('quiz.leftCount')}</span>
          <strong id="quiz-resume-left" class="quiz-resume-stat-value">0</strong>
        </div>
        <div id="quiz-resume-correct-stat" class="quiz-resume-stat quiz-resume-stat-correct">
          <span class="quiz-resume-stat-label">{t('quiz.correctSoFar')}</span>
          <strong id="quiz-resume-correct" class="quiz-resume-stat-value">0</strong>
        </div>
        <div id="quiz-resume-wrong-stat" class="quiz-resume-stat quiz-resume-stat-wrong">
          <span class="quiz-resume-stat-label">{t('quiz.wrongSoFar')}</span>
          <strong id="quiz-resume-wrong" class="quiz-resume-stat-value">0</strong>
        </div>
      </div>
    </div>

    <div class="quiz-resume-actions">
      <button id="quiz-continue-btn" type="button" class="quiz-primary">
        {t('quiz.continueSolving')}
        <svg aria-hidden="true" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="rtl:rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
      <div class="quiz-resume-secondary-actions">
        <button id="quiz-redo-btn" type="button" class="quiz-secondary">{t('quiz.redoExam')}</button>
        <button id="quiz-resume-settings-btn" type="button" class="quiz-secondary">{t('quiz.settings')}</button>
      </div>
    </div>
  </div>

  <div id="quiz-active-screen" class="hidden quiz-screen">
    <div class="quiz-session-header">
      <span class="quiz-counter"><span id="quiz-counter-wrapper" set:html={t('quiz.currentQuestion').replace('{current}', '<span id="quiz-current-question-num">1</span>').replace('{total}', `<span id="quiz-total-questions-num">${practiceQuestions.length}</span>`)} /></span>
      <span id="quiz-timer" class="hidden" role="timer" aria-label={t('quiz.timeRemaining')}></span>
    </div>
    <div class="quiz-progress-track"><div id="quiz-progress-bar" class="h-full w-0"></div></div>

    <div id="quiz-question-content" dir={quiz.lang === 'ar' ? 'rtl' : 'ltr'} lang={quiz.lang || 'en'} class="quiz-question-content">
      <h3 id="quiz-question-text" tabindex="-1">Question loading...</h3>
      <pre id="quiz-question-code" class="hidden"></pre>
      <div id="quiz-options-container"></div>
    </div>
    <p id="quiz-answer-status" role="status"></p>

    <div id="quiz-explanation-box" class="hidden">
      <svg aria-hidden="true" class="quiz-explanation-icon" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364.364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
      <div>
        <h4>{t('quiz.explanation')}</h4>
        <p id="quiz-explanation-text" dir={quiz.lang === 'ar' ? 'rtl' : 'ltr'} lang={quiz.lang || 'en'}>Explanation content...</p>
        <p id="quiz-source-slide" />
        <p id="quiz-origin" />
        <p id="quiz-answer-warning" />
        <p id="quiz-study-resource" class="hidden" />
      </div>
    </div>

    <div id="quiz-controls" class="quiz-controls" role="group" aria-label={t('quiz.navigation')}>
      <div class="quiz-controls-inner">
        <button id="quiz-previous-btn" class="hidden quiz-secondary">{t('quiz.previous')}</button>
        <button id="quiz-submit-btn" class="hidden quiz-secondary">{t('quiz.submit')}</button>
        <button id="quiz-next-btn" class="quiz-primary">{t('quiz.next')}</button>
      </div>
    </div>
    <QuestionIssue />
  </div>

  <div id="quiz-result-screen" class="hidden quiz-screen">
    <div class="quiz-result-heading">
      <div class="quiz-result-icon" aria-hidden="true"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg></div>
      <h2 id="quiz-result-title" tabindex="-1" class="quiz-title">{t('quiz.completed')}</h2>
      <p id="quiz-performance-desc">{t('quiz.breakdown')}</p>
      <p id="quiz-custom-score-notice" class="quiz-help hidden">{t('quiz.customScoreNotice')}</p>
      <p id="quiz-expired-message" class="hidden" role="status">{t('quiz.expired')}</p>
    </div>

    <div class="quiz-scorecard">
      <div><span>{t('quiz.correct')}</span><strong id="quiz-score-ratio">0/0</strong></div>
      <div><span>{t('quiz.percentage')}</span><strong id="quiz-score-percentage">0%</strong></div>
      <p>{t('quiz.sessionScore')}</p>
    </div>

    <section class="quiz-result-section" aria-labelledby="quiz-topic-title">
      <h3 id="quiz-topic-title">{t('quiz.topicBreakdown')}</h3>
      <div class="quiz-table-wrap"><table>
        <thead><tr><th scope="col">{t('quiz.topicLabel')}</th><th scope="col">{t('quiz.topicScore')}</th></tr></thead>
        <tbody id="quiz-topic-results" />
      </table></div>
    </section>
    <section id="quiz-study-next" class="quiz-result-section hidden" aria-labelledby="quiz-study-next-title">
      <h3 id="quiz-study-next-title">{t('quiz.studyNext')}</h3>
      <div id="quiz-study-next-links"></div>
    </section>
    <section class="quiz-result-section" aria-labelledby="quiz-review-title">
      <h3 id="quiz-review-title">{t('quiz.mistakes')}</h3>
      <div id="quiz-mistake-list" />
      <button id="quiz-retry-missed-btn" class="hidden quiz-secondary">{t('quiz.retryMissed')}</button>
    </section>

    <div class="quiz-result-actions">
      <button id="quiz-restart-btn" class="quiz-primary">{t('quiz.fullRetry')}</button>
      <button id="quiz-settings-btn" class="quiz-secondary">{t('quiz.settings')}</button>
      <a id="quiz-back-btn" href={backUrl} class="quiz-secondary">{t('quiz.back')}</a>
    </div>
  </div>
  {quiz.subject === 'Operating Systems' && <div class="quiz-dinosaur" title={t('quiz.dinosaur')}><img src={`${import.meta.env.BASE_URL}images/os-dinosaur.jpg`} alt={t('quiz.dinosaur')} width="60" height="47" loading="lazy" /></div>}
  {quiz.subject === 'Operating Systems' && <div class="quiz-shawarma" title={t('quiz.shawarma')}><img src={`${import.meta.env.BASE_URL}images/os-shawarma.png`} alt={t('quiz.shawarma')} width="60" height="60" loading="lazy" /></div>}
  <p id="quiz-storage-status" role="status" />
</div>

<script src="../scripts/quiz.ts"></script>
