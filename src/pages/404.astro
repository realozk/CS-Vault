---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you are looking for does not exist.">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <span class="text-7xl font-extrabold text-gray-200 dark:text-zinc-800">404</span>
    <h1 class="mt-4 text-2xl font-bold text-gray-900 dark:text-white tracking-tight">Page Not Found</h1>
    <p class="mt-2 text-sm text-gray-500 dark:text-zinc-400 max-w-sm">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <a
      href={import.meta.env.BASE_URL}
      class="mt-6 px-5 py-2.5 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold text-sm rounded hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors"
    >
      Back to Home
    </a>
  </div>
</Layout>
