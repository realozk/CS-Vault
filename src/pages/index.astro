---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SemesterSection from '../components/SemesterSection.astro';
import { getModules } from '../lib/modules';
import { useTranslations } from '../i18n/ui';
const t = useTranslations('en');

// Fetch all summaries and quizzes to discover available subject/year modules
const summaries = await getCollection('summaries');
const quizzes = await getCollection('quizzes');



const modules = await getModules();

// Auto-detect default year tab (first year with content)
const availableYears = [...new Set(modules.map(m => m.yearLevel))].sort((a, b) => a - b);
const defaultYear = availableYears.length > 0 ? availableYears[0] : 1;

const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Compile Client-Side Search Index
const searchIndex = [
  ...modules.map(m => ({
    type: 'subject', title: m.subjectName, description: 'Semester ' + m.semester,
    author: '', subjectCode: m.subject, year: m.year,
    url: `${BASE_URL}${m.subject}/${m.year}`,
    yearLevel: m.yearLevel, semester: m.semester
  })),
  ...summaries.map(s => {
    const parts = s.id.split('/');
    return {
      type: 'summary',
      title: s.data.title,
      description: s.data.description,
      author: s.data.author,
      subjectCode: s.data.subject_code,
      year: parts[1],
      url: `${BASE_URL}${parts[0]}/${parts[1]}`,
      yearLevel: s.data.year_level,
      semester: s.data.semester
    };
  }),
  ...quizzes.map(q => {
    const parts = q.id.split('/');
    const slug = parts.slice(2).join('-').replace(/\.(md|json)$/, '');
    return {
      type: 'quiz',
      title: q.data.title,
      description: `Interactive test for ${q.data.subject}`,
      author: 'System',
      subjectCode: q.data.subject,
      year: parts[1],
      url: `${BASE_URL}${parts[0]}/${parts[1]}/quiz/${slug}`,
      yearLevel: q.data.year_level,
      semester: q.data.semester
    };
  })
];
---

<Layout title="Home" description={t('hero.desc')}>
  <!-- Falling Binary background disabled -->

  <div class="home-layout space-y-6 py-2">
    
    <!-- Hero / Welcome Panel -->
    <div class="home-welcome relative overflow-hidden rounded-md bg-linear-to-r from-zinc-900 to-zinc-950 dark:from-zinc-950/80 dark:to-zinc-900/40 py-8 px-6 sm:py-10 sm:px-10 text-white border border-zinc-800 shadow-sm">
      <div class="relative max-w-2xl z-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight bg-linear-to-r from-white via-zinc-100 to-blue-400 bg-clip-text text-transparent">
          {t('hero.title')}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-zinc-300 font-light">
          {t('hero.desc')}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a 
            href="https://github.com/realozk/CS-Vault" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-4 py-2 border border-zinc-700 hover:border-zinc-500 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-semibold rounded transition-all duration-150"
          >
            {t('hero.contribute')}
          </a>
        </div>
      </div>
      <!-- Background decoration -->
      <div class="absolute right-0 bottom-0 opacity-[0.05] pointer-events-none transform translate-y-1/4 translate-x-1/4">
        <svg class="w-80 h-80 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 17l6-6-6-6M12 19h8" />
        </svg>
      </div>
    </div>

    <!-- Search Engine Section -->
    <div class="home-search relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400 dark:text-zinc-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input 
        type="text" 
        id="global-search-input"
        placeholder="Search summaries, subjects, quizzes..." 
        class="block w-full pl-10 pr-4 py-3 border border-gray-300/80 dark:border-zinc-700/65 rounded-md bg-white dark:bg-zinc-900/40 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500/80 focus:border-blue-500 text-sm shadow-xs transition-all duration-150"
      />
    </div>

    <!-- Main Directory Block -->
    <div id="directory-container" class="space-y-6 scroll-mt-24" data-search-index={JSON.stringify(searchIndex)}>
      
      <!-- Search Results Pane (Initially Hidden) -->
      <div id="search-results-pane" class="hidden space-y-4">
        <h2 class="text-xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>Search Results</span>
          <span id="search-results-count" class="text-xs bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-150 dark:border-blue-900 px-2 py-0.5 rounded-sm">0 matches</span>
        </h2>
        <div id="search-results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Results injected here -->
        </div>
        <div id="search-no-results" class="hidden text-center py-12 border border-dashed border-gray-200 dark:border-zinc-800/85 rounded-md bg-gray-50/30 dark:bg-zinc-900/10">
          <svg class="w-10 h-10 text-gray-300 dark:text-zinc-700 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2050/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75l-2.489-2.489m0 0a3.375 3.375 0 10-4.773-4.773 3.375 3.375 0 004.774 4.774zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm text-gray-400 dark:text-zinc-500 max-w-xs mx-auto">No study material matches your query. Try another keyword!</p>
        </div>
      </div>

      <!-- Core Tab View (Hidden during active search) -->
      <div id="core-tab-view" class="directory-layout">
        
        <!-- Year Selection Tabs -->
        <div class="year-sidebar flex border-b border-gray-200 dark:border-zinc-800 overflow-x-auto pb-px gap-1" id="year-tabs-nav">
          {[1, 2, 3, 4].map((year) => (
            <button
              data-year-tab={year}
              class={`px-5 py-3 border-b-2 font-bold text-sm tracking-tight transition-all duration-150 whitespace-nowrap cursor-pointer ${
                year === defaultYear 
                  ? 'border-blue-600 dark:border-blue-500 text-blue-600 dark:text-blue-400' 
                  : 'border-transparent text-gray-500 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-200 dark:hover:border-zinc-800'
              }`}
            >
              Academic Year {year}
            </button>
          ))}
        </div>

        <!-- Course Lists organized by Semester -->
        {[1, 2, 3, 4].map((yearNum) => {
          const yearModules = modules.filter(m => m.yearLevel === yearNum);
          
          return (
            <div data-year-content={yearNum} class={`year-material space-y-10 ${yearNum === defaultYear ? '' : 'hidden'}`}>
              {yearModules.length === 0 ? (
                <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-12 text-center flex flex-col items-center justify-center">
                  <svg class="w-12 h-12 text-gray-300 dark:text-zinc-700 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <h3 class="font-bold text-lg text-gray-700 dark:text-zinc-300">Year {yearNum} content is empty</h3>
                  <p class="text-sm text-gray-400 mt-1 max-w-sm">No summaries or quizzes have been uploaded for Year {yearNum} yet. Be the first to push content to the git repository!</p>
                  <a 
                    href="https://github.com/realozk/CS-Vault" 
                    target="_blank" 
                    class="mt-4 px-4 py-2 border border-gray-250 dark:border-zinc-700 hover:border-zinc-500 rounded bg-gray-50 dark:bg-zinc-800 text-xs font-semibold"
                  >
                    View Contributing Guidelines
                  </a>
                </div>
              ) : (
                <div class="space-y-8">
                  
                  {[1, 2].filter(sem => yearModules.some(m => m.semester === sem)).map((sem) => (
                    <SemesterSection 
                      semester={sem} 
                      modules={yearModules.filter(m => m.semester === sem)}
                      accentColor={sem === 1 ? 'blue' : 'indigo'}
                    />
                  ))}

                </div>
              )}
            </div>
          );
        })}
      </div>
      
    </div>
  </div>
</Layout>

<script src="../scripts/home.ts"></script>
