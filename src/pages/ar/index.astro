---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SemesterSection from '../../components/SemesterSection.astro';
import type { ModuleItem } from '../../types';
import { useTranslations, getLocalizedPath } from '../../i18n/ui';

const t = useTranslations('ar');

// Fetch all summaries and quizzes to discover available subject/year modules
const summaries = await getCollection('summaries');
const quizzes = await getCollection('quizzes');

const modulesMap = new Map<string, ModuleItem>();

// Process summaries
summaries.forEach((s) => {
  const parts = s.id.split('/');
  if (parts.length >= 2) {
    const subject = parts[0];
    const year = parts[1];
    const key = `${subject}/${year}`;
    
    const existing = modulesMap.get(key) || {
      subject,
      subjectName: s.data.subject_code,
      year,
      yearLevel: s.data.year_level,
      semester: s.data.semester,
      summariesCount: 0,
      quizzesCount: 0,
    };
    existing.summariesCount++;
    modulesMap.set(key, existing);
  }
});

// Process quizzes
quizzes.forEach((q) => {
  const parts = q.id.split('/');
  if (parts.length >= 2) {
    const subject = parts[0];
    const year = parts[1];
    const key = `${subject}/${year}`;
    
    const existing = modulesMap.get(key) || {
      subject,
      subjectName: q.data.subject,
      year,
      yearLevel: q.data.year_level,
      semester: q.data.semester,
      summariesCount: 0,
      quizzesCount: 0,
    };
    existing.quizzesCount++;
    modulesMap.set(key, existing);
  }
});

const modules = Array.from(modulesMap.values()).sort((a, b) => {
  if (a.subjectName !== b.subjectName) {
    return a.subjectName.localeCompare(b.subjectName);
  }
  return b.year.localeCompare(a.year);
});

// Auto-detect default year tab (first year with content)
const availableYears = [...new Set(modules.map(m => m.yearLevel))].sort((a, b) => a - b);
const defaultYear = availableYears.length > 0 ? availableYears[0] : 1;

// Compile Client-Side Search Index
const searchIndex = [
  ...summaries.map(s => {
    const parts = s.id.split('/');
    return {
      type: 'summary',
      title: s.data.title,
      description: s.data.description,
      author: s.data.author,
      subjectCode: s.data.subject_code,
      year: parts[1],
      url: `/ar/${parts[0]}/${parts[1]}`,
      yearLevel: s.data.year_level,
      semester: s.data.semester
    };
  }),
  ...quizzes.map(q => {
    const parts = q.id.split('/');
    const slug = parts.slice(2).join('-').replace(/\.(md|json)$/, '');
    return {
      type: 'quiz',
      title: q.data.title,
      description: `Interactive test for ${q.data.subject}`,
      author: 'System',
      subjectCode: q.data.subject,
      year: parts[1],
      url: `/ar/${parts[0]}/${parts[1]}/quiz/${slug}`,
      yearLevel: q.data.year_level,
      semester: q.data.semester
    };
  })
];

const searchIndexTranslations = JSON.stringify({
  resultsCount: t('search.resultsCount'),
  summaryBadge: t('search.summaryBadge'),
  quizBadge: t('search.quizBadge'),
  readNow: t('search.readNow'),
  yearAndSem: t('search.yearAndSem')
});
---

<Layout title="الرئيسية - مركز المواد الأكاديمية" description={t('hero.desc')}>
  <div class="space-y-10 py-2">
    
    <!-- Hero / Welcome Panel -->
    <div class="relative overflow-hidden rounded-md bg-linear-to-r from-zinc-900 to-zinc-950 dark:from-zinc-950/80 dark:to-zinc-900/40 py-8 px-6 sm:py-10 sm:px-10 text-white border border-zinc-800 shadow-sm">
      <div class="relative max-w-2xl z-10">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-sm bg-zinc-800 border border-zinc-700 text-[10px] font-bold uppercase tracking-wider mb-4">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
          {t('hero.badge')}
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
          {t('hero.title')}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-zinc-300 font-light">
          {t('hero.desc')}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a 
            href="#directory-container" 
            class="px-4 py-2 bg-white text-zinc-950 hover:bg-zinc-100 text-sm font-semibold rounded transition-all duration-150 shadow-xs"
          >
            {t('hero.browse')}
          </a>
          <a 
            href="https://github.com/realozk/CS-Vault" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-4 py-2 border border-zinc-700 hover:border-zinc-500 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-semibold rounded transition-all duration-150"
          >
            {t('hero.contribute')}
          </a>
        </div>
      </div>
      <!-- Background decoration -->
      <div class="absolute left-0 bottom-0 opacity-[0.07] pointer-events-none transform translate-y-1/3 -translate-x-1/3">
        <svg class="w-80 h-80 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
          <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479L12 20l-6.825-2.943a12.083 12.083 0 01.665-6.479L12 14z"></path>
        </svg>
      </div>
    </div>

    <!-- Search Engine Section -->
    <div class="relative max-w-xl mx-auto">
      <div class="absolute inset-y-0 start-0 ps-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400 dark:text-zinc-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input 
        type="text" 
        id="global-search-input"
        placeholder={t('search.placeholder')} 
        class="block w-full ps-10 pe-4 py-3 border border-gray-200 dark:border-zinc-800 rounded-md bg-white dark:bg-zinc-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm shadow-xs transition-all duration-150"
      />
    </div>

    <!-- Main Directory Block -->
    <div id="directory-container" class="space-y-6 scroll-mt-24" data-search-index={JSON.stringify(searchIndex)} data-translations={searchIndexTranslations}>
      
      <!-- Search Results Pane (Initially Hidden) -->
      <div id="search-results-pane" class="hidden space-y-4">
        <h2 class="text-xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>{t('search.results')}</span>
          <span id="search-results-count" class="text-xs bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-150 dark:border-blue-900 px-2 py-0.5 rounded-sm">0 {t('search.resultsCount')}</span>
        </h2>
        <div id="search-results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Results injected here -->
        </div>
        <div id="search-no-results" class="hidden text-center py-12 border border-dashed border-gray-200 dark:border-zinc-800 rounded-md">
          <p class="text-gray-400 dark:text-zinc-500">{t('search.noResults')}</p>
        </div>
      </div>

      <!-- Core Tab View (Hidden during active search) -->
      <div id="core-tab-view" class="space-y-6">
        
        <!-- Year Selection Tabs -->
        <div class="flex border-b border-gray-200 dark:border-zinc-800 overflow-x-auto pb-px gap-1" id="year-tabs-nav">
          {[1, 2, 3, 4].map((year) => (
            <button
              data-year-tab={year}
              class={`px-5 py-3 border-b-2 font-bold text-sm tracking-tight transition-all duration-150 whitespace-nowrap cursor-pointer ${
                year === defaultYear 
                  ? 'border-blue-600 dark:border-blue-500 text-blue-600 dark:text-blue-400' 
                  : 'border-transparent text-gray-500 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-200 dark:hover:border-zinc-800'
              }`}
            >
              {t('year.tab').replace('{year}', year.toString())}
            </button>
          ))}
        </div>

        <!-- Course Lists organized by Semester -->
        {[1, 2, 3, 4].map((yearNum) => {
          const yearModules = modules.filter(m => m.yearLevel === yearNum);
          
          return (
            <div data-year-content={yearNum} class={`space-y-10 ${yearNum === defaultYear ? '' : 'hidden'}`}>
              {yearModules.length === 0 ? (
                <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-12 text-center flex flex-col items-center justify-center">
                  <svg class="w-12 h-12 text-gray-300 dark:text-zinc-700 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <h3 class="font-bold text-lg text-gray-700 dark:text-zinc-300">{t('year.empty').replace('{year}', yearNum.toString())}</h3>
                  <p class="text-sm text-gray-400 mt-1 max-w-sm">{t('year.emptyDesc').replace('{year}', yearNum.toString())}</p>
                  <a 
                    href="https://github.com/realozk/CS-Vault" 
                    target="_blank" 
                    class="mt-4 px-4 py-2 border border-gray-250 dark:border-zinc-700 hover:border-zinc-500 rounded bg-gray-50 dark:bg-zinc-800 text-xs font-semibold"
                  >
                    {t('year.contributeGuidelines')}
                  </a>
                </div>
              ) : (
                <div class="space-y-8">
                  
                  {[1, 2].map((sem) => (
                    <SemesterSection 
                      semester={sem} 
                      modules={yearModules.filter(m => m.semester === sem)}
                      accentColor={sem === 1 ? 'blue' : 'indigo'}
                    />
                  ))}

                </div>
              )}
            </div>
          );
        })}
      </div>
      
    </div>
  </div>
</Layout>

<script src="../../scripts/home.ts"></script>
