---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import { useTranslations, getLocalizedPath } from '../../../../i18n/ui';

const t = useTranslations('ar');

export async function getStaticPaths() {
  const summaries = await getCollection('summaries');
  const quizzes = await getCollection('quizzes');
  
  const paths = new Map<string, { subject: string; year: string }>();
  
  summaries.forEach((entry) => {
    const parts = entry.id.split('/');
    if (parts.length >= 2) {
      const subject = parts[0];
      const year = parts[1];
      paths.set(`${subject}/${year}`, { subject, year });
    }
  });

  quizzes.forEach((entry) => {
    const parts = entry.id.split('/');
    if (parts.length >= 2) {
      const subject = parts[0];
      const year = parts[1];
      paths.set(`${subject}/${year}`, { subject, year });
    }
  });

  return Array.from(paths.values()).map((p) => ({
    params: { subject: p.subject, year: p.year },
  }));
}

const { subject, year } = Astro.params;

// Fetch collections filtering by subject and year folder structure
const rawSummaries = await getCollection('summaries', (entry) => {
  const parts = entry.id.split('/');
  return parts[0] === subject && parts[1] === year;
});

const rawQuizzes = await getCollection('quizzes', (entry) => {
  const parts = entry.id.split('/');
  return parts[0] === subject && parts[1] === year;
});

// Helper to get slug from file path
const getSlug = (id: string) => {
  const parts = id.split('/');
  return parts.slice(2).join('-').replace(/\.(md|json)$/, '');
};

// Render summary content
const summaries = await Promise.all(
  rawSummaries.map(async (entry) => {
    const { Content } = await render(entry);
    const words = entry.body ? entry.body.split(/\s+/g).length : 0;
    const readingTime = Math.ceil(words / 200) || 1;
    return {
      entry,
      Content,
      slug: getSlug(entry.id),
      readingTime
    };
  })
);

const quizzes = rawQuizzes.map((entry) => ({
  entry,
  slug: getSlug(entry.id)
}));

const pageTitle = `${subject.toUpperCase()} (${year})`;
const trackerTranslations = JSON.stringify({
  progressPerfect: t('dashboard.progressPerfect'),
  progressKeepUp: t('dashboard.progressKeepUp'),
  progressStatus: t('dashboard.progressStatus'),
});
---

<Layout title={pageTitle} description={`ملخصات واختبارات تفاعلية لمادة ${subject.toUpperCase()} - السنة الدراسية ${year}`}>
  <div class="space-y-6">
    
    <!-- Dashboard Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-gray-200 dark:border-zinc-800">
      <div>
        <nav class="flex items-center space-x-2 space-x-reverse text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">
          <a href="/ar" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{t('dashboard.breadcrumbs')}</a>
          <span>/</span>
          <span class="text-gray-800 dark:text-gray-200">{subject}</span>
          <span>/</span>
          <span class="text-gray-800 dark:text-gray-200">{year}</span>
        </nav>
        <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-3">
          <span>{subject.toUpperCase()}</span>
          <span class="text-gray-300 dark:text-zinc-700">|</span>
          <span class="text-lg font-medium text-gray-500 dark:text-gray-400">{t('dashboard.academicYear').replace('{year}', year)}</span>
        </h1>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Panel: Sidebar Index of Content (Columns: 4) -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Study Progress Tracker Widget -->
        {summaries.length > 0 && (
          <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-5 shadow-xs" id="subject-progress-card" data-translations={trackerTranslations}>
            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 dark:text-zinc-500 mb-3 flex items-center justify-between">
              <span>التقدم الدراسي</span>
              <span id="progress-percentage-text" class="text-blue-600 dark:text-blue-400 font-bold">0%</span>
            </h2>
            <div class="w-full h-2 bg-gray-250 dark:bg-gray-800 rounded-full mb-2.5">
              <div id="subject-progress-fill" class="h-full bg-[#22d3ee] shadow-[0_0_10px_rgba(34,211,238,0.45)] rounded-full w-0 transition-all duration-300"></div>
            </div>
            <p class="text-xs text-gray-500 dark:text-zinc-400" id="progress-status-desc">
              جاري حساب الإنجاز...
            </p>
          </div>
        )}

        <!-- Summaries Section -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-5 shadow-xs">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 dark:text-zinc-500 mb-4 flex items-center justify-between">
            <span>{t('dashboard.summaries')}</span>
            <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 text-xs px-2 py-0.5 rounded-sm">
              {summaries.length}
            </span>
          </h2>
          
          {summaries.length === 0 ? (
            <p class="text-sm text-gray-400 dark:text-zinc-500 italic py-2">{t('dashboard.emptySummaries')}</p>
          ) : (
            <div class="space-y-2.5" id="summary-tabs">
              {summaries.map((s, idx) => (
                <button
                  data-summary-slug={s.slug}
                  class={`w-full text-right p-3.5 rounded border transition-all duration-150 cursor-pointer flex flex-col gap-1 text-sm summary-tab-btn ${
                    idx === 0 
                      ? 'border-blue-600 dark:border-blue-500 bg-blue-50/10 dark:bg-blue-950/10 text-blue-950 dark:text-blue-100 font-semibold shadow-xs' 
                      : 'border-gray-100 dark:border-zinc-800 hover:border-gray-300 dark:hover:border-zinc-700 text-gray-600 dark:text-zinc-300'
                  }`}
                >
                  <div class="flex items-start gap-2.5">
                    <input 
                      type="checkbox" 
                      data-summary-check={s.slug} 
                      class="summary-checkbox mt-1 w-4 h-4 text-blue-650 rounded border-gray-300 dark:border-zinc-700 focus:ring-blue-500 cursor-pointer"
                    />
                    <div class="flex-grow">
                      <span class="font-bold block tracking-tight line-clamp-1 summary-title-text text-start">{s.entry.data.title}</span>
                      <span class="text-xs text-gray-400 dark:text-zinc-500 line-clamp-1 text-start">{s.entry.data.description}</span>
                      <div class="text-xs text-gray-400 dark:text-zinc-500 mt-1 flex items-center gap-1.5 flex-wrap">
                        <span>{t('dashboard.author').replace('{author}', s.entry.data.author)}</span>
                        <span>•</span>
                        <span class="flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span>{t('dashboard.readTime').replace('{time}', s.readingTime.toString())}</span>
                        </span>
                      </div>
                    </div>
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Quizzes Section -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-5 shadow-xs">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 dark:text-zinc-500 mb-4 flex items-center justify-between">
            <span>{t('dashboard.quizzes')}</span>
            <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 text-xs px-2 py-0.5 rounded-sm">
              {quizzes.length}
            </span>
          </h2>
          
          {quizzes.length === 0 ? (
            <p class="text-sm text-gray-400 dark:text-zinc-500 italic py-2">{t('dashboard.emptyQuizzes')}</p>
          ) : (
            <div class="space-y-3">
              {quizzes.map((q) => (
                <a
                  href={`/ar/${subject}/${year}/quiz/${q.slug}`}
                  class="group block p-4 rounded border border-gray-100 dark:border-zinc-800 hover:border-blue-600 dark:hover:border-blue-500 bg-gray-50/50 dark:bg-zinc-800/10 hover:bg-blue-50/5 dark:hover:bg-blue-950/5 transition-all duration-150"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-bold text-sm tracking-tight text-gray-800 dark:text-zinc-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {q.entry.data.title}
                    </span>
                    <span class="text-xs text-gray-400 dark:text-zinc-500 flex-shrink-0">
                      {q.entry.data.questions.length} أسئلة
                    </span>
                  </div>
                  <span class="text-xs text-gray-400 dark:text-zinc-500 flex items-center gap-1 mt-1">
                    <span>{t('dashboard.practice')}</span>
                    <svg class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-150 rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Right Panel: Reading Pane for Summaries (Columns: 8) -->
      <div class="lg:col-span-8 bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-md p-6 sm:p-8 shadow-xs min-h-[500px]">
        {summaries.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-20 text-center text-gray-400 dark:text-zinc-500">
            <svg class="w-12 h-12 text-gray-400 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <h3 class="font-bold text-lg text-gray-700 dark:text-zinc-300">لا يوجد محتوى للقراءة</h3>
            <p class="text-sm mt-1">لا تتوفر ملخصات دراسية لهذه المادة حالياً.</p>
          </div>
        ) : (
          <div>
            <!-- Rendered Summaries -->
            {summaries.map((s, idx) => (
              <div
                id={`summary-content-${s.slug}`}
                class={`summary-content-block ${idx === 0 ? '' : 'hidden'}`}
              >
                <!-- Summary Header -->
                <div class="mb-6 pb-6 border-b border-gray-100 dark:border-zinc-800">
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
                    {s.entry.data.title}
                  </h2>
                  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 dark:text-gray-400 font-medium">
                    <span class="flex items-center gap-1.5">
                      <Icon name="user" class="w-3.5 h-3.5 text-gray-400" />
                      <span>الكاتب:</span>
                      <strong class="text-gray-800 dark:text-gray-200">{s.entry.data.author}</strong>
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1.5">
                      <Icon name="calendar" class="w-3.5 h-3.5 text-gray-400" />
                      <span>تاريخ النشر:</span>
                      <strong class="text-gray-800 dark:text-gray-200">
                        {s.entry.data.date.toLocaleDateString('ar-EG', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </strong>
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1.5">
                      <Icon name="clock" class="w-3.5 h-3.5 text-gray-400" />
                      <span>وقت القراءة:</span>
                      <strong class="text-gray-800 dark:text-gray-200">{t('dashboard.readTime').replace('{time}', s.readingTime.toString())}</strong>
                    </span>
                  </div>
                </div>

                <!-- Markdown Content Render -->
                <article class="academic-prose max-w-none text-left" dir="ltr">
                  <s.Content />
                </article>

                <!-- Page Navigation Buttons -->
                {summaries.length > 1 && (
                  <div class="mt-8 pt-6 border-t border-gray-150 dark:border-dark-border flex items-center justify-between gap-4">
                    <div>
                      {idx > 0 && (
                        <button
                          data-nav-prev={summaries[idx - 1].slug}
                          class="px-4 py-2 border border-gray-250 dark:border-dark-border rounded-md hover:bg-gray-50 dark:hover:bg-zinc-800 text-xs font-semibold text-gray-700 dark:text-zinc-300 transition-colors cursor-pointer flex items-center gap-1.5"
                        >
                          <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                          </svg>
                          <span>{t('nav.previous')}</span>
                        </button>
                      )}
                    </div>
                    <div>
                      {idx < summaries.length - 1 ? (
                        <button
                          data-nav-next={summaries[idx + 1].slug}
                          data-current-slug={s.slug}
                          class="px-4 py-2 bg-brand-500 hover:bg-brand-650 dark:bg-brand-500 dark:hover:bg-brand-600 text-zinc-950 text-xs font-bold rounded shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center gap-1.5"
                        >
                          <span>{t('nav.next')}</span>
                          <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                          </svg>
                        </button>
                      ) : (
                        <button
                          data-nav-finish={s.slug}
                          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center gap-1.5"
                        >
                          <span>{t('nav.finish')}</span>
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                        </button>
                      )}
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script src="../../../../scripts/subject-dashboard.ts"></script>
