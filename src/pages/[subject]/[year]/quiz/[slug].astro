---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import QuizWidget from '../../../../components/QuizWidget.astro';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  
  return quizzes.map((entry) => {
    const parts = entry.id.split('/');
    const subject = parts[0];
    const year = parts[1];
    
    // Create the slug matching the format generated in the index page
    const slug = parts.slice(2).join('-').replace(/\.(md|json)$/, '');
    
    return {
      params: { subject, year, slug },
      props: { quiz: entry },
    };
  });
}

const { quiz } = Astro.props;
const { subject, year } = Astro.params;

const pageTitle = `${quiz.data.title} - Quiz`;
---

<Layout title={pageTitle} description={`Take the interactive practice quiz: ${quiz.data.title} for ${subject.toUpperCase()} (${year})`}>
  <div class="space-y-6">
    <!-- Quiz Nav Header -->
    <div class="max-w-2xl mx-auto flex items-center justify-between">
      <a 
        href={`/${subject}/${year}`} 
        class="inline-flex items-center text-sm font-semibold text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Dashboard
      </a>

    </div>

    <!-- Main Widget Container -->
    <div class="py-4">
      <QuizWidget quiz={quiz.data} backUrl={`/${subject}/${year}`} />
    </div>
  </div>
</Layout>
