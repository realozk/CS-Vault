# CS-Vault pipeline config. Copy to `.env` and fill in.
# Local only — `.env` is gitignored, never committed.
# Note: no PUBLIC_ prefix here. That prefix is Astro-only; this is not the site.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PROMPT_VERSION=v1

# --- Google Drive ---
# ID of the folder holding the past-exam PDFs/photos.
GOOGLE_DRIVE_FOLDER_ID=
# Path to the OAuth client-secrets JSON downloaded from Google Cloud.
GOOGLE_OAUTH_CLIENT_SECRETS=./credentials.json

# --- Runtime ---
# Max concurrent vision calls (semaphore). ~10-20.
PIPELINE_CONCURRENCY=12
